<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>Interview Prep Hub</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script>
  // Applied before first paint to avoid a light/dark flash on load.
  // 'theme' in localStorage holds the MODE ('auto'/'light'/'dark'), not
  // the resolved scheme -- 'auto' resolves against the OS preference
  // every time (here, and live via a matchMedia listener once the main
  // script runs), rather than only snapshotting it once on first visit.
  (function(){
    try{
      var mode = localStorage.getItem('theme') || 'auto';
      var resolved = mode === 'auto'
        ? (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
        : mode;
      document.documentElement.setAttribute('data-theme', resolved);
    }catch(e){
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  })();
</script>
<style>
  :root{
    --bg-grad-1:#0b1120;
    --bg-grad-2:#0f172a;
    --surface:#161f36;
    --surface-2:#1c2740;
    --surface-3:#24304d;
    --text:#e7ecf7;
    --muted:#8b96ad;
    --accent:#7c6ef2;
    --accent-2:#9b8ffb;
    --accent-soft:rgba(124,110,242,.16);
    --border:rgba(255,255,255,.08);
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 12px 32px -12px rgba(0,0,0,.55);
    --shadow-sm:0 1px 2px rgba(0,0,0,.3);
    --danger:#f87171;
    --tag-cat-bg:rgba(124,110,242,.16); --tag-cat-fg:#b4abfa;
    --tag-lvl-bg:rgba(45,212,191,.14); --tag-lvl-fg:#5eead4;
    --tag-pri-bg:rgba(251,191,36,.14); --tag-pri-fg:#fcd34d;
    --tag-sheet-bg:rgba(59,130,246,.16); --tag-sheet-fg:#93c5fd;
    --tag-company-bg:rgba(236,72,153,.16); --tag-company-fg:#f9a8d4;
    --code-bg:#0d1424;
    --code-fg:#cbd5e1;
    --code-kw:#c792ea;
    --code-str:#a5e075;
    --code-num:#f78c6c;
    --code-com:#5c6b8a;
    --code-ann:#ffcb6b;
    --code-type:#82aaff;
  }
  :root[data-theme="light"]{
    --bg-grad-1:#f4f6fb;
    --bg-grad-2:#e9edf6;
    --surface:#ffffff;
    --surface-2:#f6f7fb;
    --surface-3:#eef0f7;
    --text:#1c2333;
    --muted:#6b7386;
    --accent:#6a5cf0;
    --accent-2:#5647e0;
    --accent-soft:rgba(106,92,240,.1);
    --border:rgba(28,35,51,.08);
    --shadow:0 1px 2px rgba(28,35,51,.04), 0 16px 32px -16px rgba(28,35,51,.16);
    --shadow-sm:0 1px 2px rgba(28,35,51,.06);
    --danger:#dc2626;
    --tag-cat-bg:rgba(106,92,240,.1); --tag-cat-fg:#5647e0;
    --tag-lvl-bg:rgba(13,148,136,.1); --tag-lvl-fg:#0f766e;
    --tag-pri-bg:rgba(217,119,6,.12); --tag-pri-fg:#b45309;
    --tag-sheet-bg:rgba(37,99,235,.1); --tag-sheet-fg:#1d4ed8;
    --tag-company-bg:rgba(219,39,119,.1); --tag-company-fg:#be185d;
    --code-bg:#f3f4f8;
    --code-fg:#2a2f3a;
    --code-kw:#a626a4;
    --code-str:#50a14f;
    --code-num:#c18401;
    --code-com:#8a94a6;
    --code-ann:#986801;
    --code-type:#4078f2;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:linear-gradient(180deg,var(--bg-grad-1),var(--bg-grad-2));
    color:var(--text);
    min-height:100vh;
    display:flex;
    justify-content:center;
    padding:20px 16px 40px;
    -webkit-font-smoothing:antialiased;
    transition:background .2s ease, color .2s ease;
  }
  .app{
    width:100%;
    max-width:1140px;
    display:flex;
    flex-direction:column;
    gap:18px;
  }

  /* ---------- header ---------- */
  header{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:6px 2px;
  }
  .brand{display:flex; align-items:center; gap:12px; min-width:0;}
  .brand-mark{
    width:40px; height:40px;
    display:flex; align-items:center; justify-content:center;
    border-radius:12px;
    background:linear-gradient(135deg,var(--accent),var(--accent-2));
    color:#fff;
    font-size:1.15rem;
    box-shadow:var(--shadow-sm);
    flex-shrink:0;
  }
  header h1{margin:0; font-size:1.3rem; font-weight:700; letter-spacing:-.01em;}
  header p{margin:2px 0 0; color:var(--muted); font-size:.82rem;}
  /* Theme toggle (and History, sharing this class) is a standalone pill
     button — same height/shape family as the mode-toggle buttons so it
     reads as part of the same header control row, but its own bordered
     box (not inside .mode-toggle's shared pill) so it's unmistakably a
     separate control, with clear gap around it. */
  #themeToggle, .header-icon-btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    height:44px;
    padding:0 14px;
    border-radius:12px;
    border:1px solid var(--border);
    background:var(--surface);
    color:var(--text);
    font-family:inherit;
    font-size:.85rem;
    font-weight:600;
    cursor:pointer;
    white-space:nowrap;
    box-shadow:var(--shadow-sm);
    transition:border-color .15s ease, transform .1s ease;
    flex-shrink:0;
  }
  #themeToggle:hover, .header-icon-btn:hover{border-color:var(--accent-2); transform:translateY(-1px);}
  #themeToggle:active, .header-icon-btn:active{transform:translateY(0);}
  #themeToggle .theme-icon{font-size:1.05rem; line-height:1;}
  .header-actions{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    justify-content:flex-end;
    gap:14px;
    flex-shrink:0;
  }
  .mode-toggle{
    display:flex;
    align-items:center;
    height:44px;
    padding:3px;
    border-radius:12px;
    background:var(--surface-2);
    border:1px solid var(--border);
    gap:2px;
    box-sizing:border-box;
  }
  .mode-btn{
    display:flex; align-items:center; justify-content:center; gap:6px;
    height:100%;
    padding:0 14px;
    border-radius:9px;
    border:none;
    background:transparent;
    color:var(--muted);
    font-family:inherit;
    font-size:.85rem;
    font-weight:600;
    cursor:pointer;
    white-space:nowrap;
    transition:background .15s ease, color .15s ease, box-shadow .15s ease;
  }
  .mode-btn:hover{color:var(--text);}
  .mode-btn.active{
    background:var(--accent);
    color:#fff;
    box-shadow:var(--shadow-sm);
  }
  /* Full label by default; a short label takes over once space is tight,
     so the toggle never overflows/wraps mid-word on narrow phones. Applies
     to both the mode-toggle buttons and the theme button so all three
     controls shrink together, in step, rather than one overflowing while
     the others still show full text. */
  .mode-btn .label-short, #themeToggle .label-short{display:none;}
  @media (max-width:640px){
    .mode-btn .label-full, #themeToggle .label-full, .header-icon-btn .label-full{display:none;}
    .mode-btn .label-short, #themeToggle .label-short{display:inline;}
    .mode-btn{padding:0 11px; font-size:.8rem;}
    #themeToggle, .header-icon-btn{padding:0 11px; font-size:.8rem;}
  }
  @media (max-width:360px){
    /* Icon-only as a last resort on the narrowest phones. */
    .mode-btn .label-short, #themeToggle .label-short{display:none;}
    .mode-btn, #themeToggle, .header-icon-btn{padding:0 10px;}
  }

  /* ---------- interview mode: config modal ---------- */
  /* No scrolling anywhere in this form, by design: content is compact
     chip multi-selects (not tall vertical checkbox lists) laid out in a
     2-column grid, so the whole dialog fits in one viewport on desktop
     and mobile alike. Don't reintroduce per-section max-height/overflow. */
  .modal-overlay{
    position:fixed;
    inset:0;
    z-index:100;
    background:rgba(6,10,20,.55);
    backdrop-filter:blur(2px);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:12px;
  }
  .modal-overlay .card{padding:14px 16px;}
  .modal{
    width:100%;
    max-width:820px;
    display:flex;
    flex-direction:column;
    gap:11px;
  }
  .modal-header{display:flex; align-items:center; justify-content:space-between;}
  .modal-header h2{margin:0; font-size:1.1rem; font-weight:700;}
  .modal-close{
    display:flex; align-items:center; justify-content:center;
    width:28px; height:28px; border-radius:8px;
    background:none; border:none; color:var(--muted);
    font-size:1rem; cursor:pointer; line-height:1;
    transition:background .12s ease, color .12s ease;
  }
  .modal-close:hover{color:var(--text); background:var(--surface-2);}
  .modal-sub{margin:-8px 0 0; color:var(--muted); font-size:.82rem;}
  .modal-section{display:flex; flex-direction:column; gap:6px;}
  .modal-grid-2{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  .modal-section-label{
    font-size:.7rem; font-weight:600; text-transform:uppercase;
    letter-spacing:.04em; color:var(--muted);
  }
  /* Voice settings collapses behind a <summary> -- it's a sticky
     localStorage preference, not something re-picked every session, so
     hiding it by default (no forced height cost) beats showing it every
     time. Suppress the native disclosure triangle (a "▾" is already in
     the label text) and give the summary the same look as a plain
     section label, just clickable. */
  .voice-details summary{cursor:pointer; list-style:none;}
  .voice-details summary::-webkit-details-marker{display:none;}
  .voice-details[open] summary{margin-bottom:8px;}
  .voice-details .toggle-grid-2{margin-top:0;}
  .chip-group{display:flex; flex-wrap:wrap; gap:6px; align-content:flex-start;}
  .toggle-grid-2{display:grid; grid-template-columns:1fr 1fr; column-gap:16px;}
  .chip{
    display:inline-flex; align-items:center;
    padding:5px 12px;
    border-radius:999px;
    border:1.5px solid var(--border);
    background:var(--surface-2);
    color:var(--muted);
    font-family:inherit;
    font-size:.8rem;
    font-weight:600;
    cursor:pointer;
    transition:background .12s ease, border-color .12s ease, color .12s ease;
  }
  .chip:hover{border-color:var(--accent-2);}
  .chip:focus-visible{outline:2px solid var(--accent); outline-offset:2px;}
  .chip.selected{
    background:var(--accent);
    border-color:var(--accent);
    color:#fff;
  }
  .chip.chip-all{border-style:dashed;}
  .chip.chip-all.selected{border-style:solid;}
  .modal-toggle-row{display:flex; align-items:center; gap:8px; font-size:.86rem; font-weight:500; cursor:pointer; padding:4px 0;}
  /* Fully custom-drawn checkbox (appearance:none), not the native OS
     control -- accent-color alone still leaves the UNCHECKED box's look
     (border/background) up to the browser/OS theme, which on some
     Windows+Chrome setups renders as a solid black square even on a
     light page (a real OS dark-checkbox-theme bleed-through the user
     hit, not a hypothetical). Drawing both states ourselves guarantees
     the same look everywhere and matches the app's rounded/pill visual
     language (§9) instead of an inconsistent native control. */
  .modal-toggle-row input{
    appearance:none; -webkit-appearance:none;
    width:18px; height:18px; flex-shrink:0;
    border:2px solid var(--border);
    border-radius:5px;
    background:var(--surface);
    cursor:pointer;
    position:relative;
    transition:background .15s ease, border-color .15s ease;
  }
  .modal-toggle-row input:checked{
    background:var(--accent);
    border-color:var(--accent);
  }
  .modal-toggle-row input:checked::after{
    content:'';
    position:absolute; left:5px; top:1px;
    width:5px; height:9px;
    border:solid #fff; border-width:0 2px 2px 0;
    transform:rotate(45deg);
  }
  .modal-toggle-row input:hover{border-color:var(--accent-2);}
  .modal-select{
    width:100%;
    padding:10px 12px;
    border-radius:10px;
    border:1px solid var(--border);
    background:var(--surface-2);
    color:var(--text);
    font-family:inherit;
    font-size:.9rem;
    font-weight:600;
  }
  .modal-select:focus{outline:none; border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft);}
  /* Question count: a plain text box (numeric-only via inputmode +
     JS validation, not type="number") so there's no browser spinner UI
     to click through -- and narrow, not stretched to the full grid
     column width, since a 1-4 digit number doesn't need that much room. */
  .count-input{width:100%; max-width:110px;}
  .match-hint{display:block; margin-top:6px; font-size:.78rem; color:var(--muted);}
  .modal-hint{margin:2px 0 0; font-size:.78rem; color:var(--muted);}
  .voice-sub-label{display:block; font-size:.78rem; color:var(--muted); margin-bottom:4px;}
  .modal-section.needs-input .modal-section-label{color:var(--danger);}
  .modal-error{
    background:rgba(248,113,113,.12); color:var(--danger);
    border-radius:10px; padding:10px 12px; font-size:.85rem;
    overflow-wrap:break-word;
  }
  .modal-actions{display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px;}
  .modal-actions .btn{flex:0 0 auto;}
  @media (max-width:480px){
    .modal-grid-2{grid-template-columns:1fr;}
    .toggle-grid-2{grid-template-columns:1fr;}
  }

  /* History modal: a scrollable list of session cards -- unlike the
     Interview config modal, this one CAN scroll (it's a growing log, not
     a fixed-size form), capped via max-height so it doesn't blow past the
     viewport on a long history. */
  #historyModal .modal{max-width:520px;}
  #historyList{display:flex; flex-direction:column; gap:10px; max-height:60vh; overflow-y:auto;}
  .history-item{
    border:1px solid var(--border); border-radius:12px; padding:12px 14px;
    background:var(--surface-2); display:flex; flex-direction:column; gap:4px;
  }
  .history-item .history-top{display:flex; justify-content:space-between; align-items:baseline; gap:8px; flex-wrap:wrap;}
  .history-actions{display:flex; flex-wrap:wrap; gap:8px; margin-top:4px;}
  .history-item .history-date{font-weight:600; font-size:.85rem;}
  .history-item .history-duration{font-size:.8rem; color:var(--muted);}
  .history-item .history-meta{font-size:.8rem; color:var(--muted); line-height:1.5;}
  .modal-empty{color:var(--muted); font-size:.88rem; padding:18px 4px; text-align:center;}

  /* ---------- interview mode: active session ---------- */
  .interview-topbar{display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px; flex-wrap:wrap;}
  .voice-select{
    max-width:140px; min-width:0; flex-shrink:1;
    padding:6px 8px; border-radius:8px; border:1px solid var(--border);
    background:var(--surface-2); color:var(--text);
    font-family:inherit; font-size:.78rem;
  }
  @media (max-width:480px){ .voice-select{max-width:110px;} }
  .interview-timer{
    font-variant-numeric:tabular-nums;
    font-weight:700;
    font-size:.9rem;
    color:var(--accent);
    background:var(--accent-soft);
    padding:5px 12px;
    border-radius:999px;
  }
  /* Small round icon buttons for Read Aloud / Focus Mode in the interview
     topbar -- lighter-weight than a full .btn (no label, just an emoji),
     but the same accent-on-active pattern as everything else toggleable. */
  .icon-toggle-btn{
    display:flex; align-items:center; justify-content:center;
    width:34px; height:34px; flex-shrink:0;
    border-radius:10px; border:1px solid var(--border);
    background:var(--surface-2); color:var(--text);
    font-size:1rem; cursor:pointer;
    transition:border-color .15s ease, background .15s ease;
  }
  .icon-toggle-btn:hover{border-color:var(--accent-2);}
  .icon-toggle-btn.active, .icon-toggle-btn[aria-pressed="true"]{
    background:var(--accent-soft); border-color:var(--accent); color:var(--accent);
  }
  .scratch-row{display:flex; gap:8px; align-items:flex-start;}
  .scratch-box{
    flex:1; min-height:80px; resize:vertical;
    padding:10px 12px; border-radius:10px; border:1px solid var(--border);
    background:var(--surface-2); color:var(--text);
    font-family:inherit; font-size:.9rem; line-height:1.5;
  }
  #iMicBtn.active{background:var(--danger); border-color:var(--danger); color:#fff;}
  .mic-status{display:block; margin-top:6px; font-size:.8rem; color:var(--danger); font-weight:600;}
  .score-result{
    margin-top:8px; padding:10px 12px; border-radius:10px;
    background:var(--surface-2); border:1px solid var(--border); font-size:.85rem;
  }
  .score-result .score-num{font-weight:700; color:var(--accent); font-size:1rem;}
  #interviewScoreSummary{margin:14px 0;}
  .score-overall{font-size:1.3rem; font-weight:700; color:var(--accent); margin-bottom:8px;}
  .score-breakdown-row{
    display:flex; justify-content:space-between; padding:6px 0;
    border-top:1px solid var(--border); font-size:.85rem;
  }
  .preset-row{display:flex; flex-wrap:wrap; gap:8px; align-items:center;}
  .preset-row select{flex:1; min-width:160px;}
  .preset-row .btn{flex:0 0 auto;}
  /* Focus Mode: dims/hides secondary chrome around the session card for a
     more immersive practice feel -- does NOT touch the header/mode-toggle
     (that stays reachable at all times, per RULES.md's "no dead end"
     rule), only shrinks the browse-toolbar-adjacent page chrome and
     enlarges the question/answer text itself. */
  body.focus-mode .app > header{opacity:.45; transition:opacity .15s ease;}
  body.focus-mode .app > header:hover{opacity:1;}
  body.focus-mode #interviewCard .q-part{font-size:1.2rem;}
  body.focus-mode #interviewCard .field-value{font-size:1.05rem;}
  #interviewCard{display:flex; flex-direction:column; gap:14px;}
  .q-parts{display:flex; flex-direction:column; gap:8px;}
  /* Browse mode's stacked phrasings (no "Q." label, no Interview Mode
     font-weight/size) -- just plain lines matching whatever font-size the
     surrounding Question cell/field already uses, so a 2-phrasing row
     doesn't render visually bolder/bigger than a 1-phrasing row next to
     it. Interview Mode's own .q-part (below) is intentionally separate. */
  .q-line{line-height:1.5;}
  .q-part{
    display:flex; gap:8px; align-items:baseline;
    font-weight:600; font-size:1.05rem; line-height:1.5;
  }

  .card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:16px;
    padding:18px;
    box-shadow:var(--shadow);
  }

  /* ---------- toolbar / filters ---------- */
  .toolbar{display:flex; flex-direction:column; gap:14px;}
  .search-row{position:relative;}
  .search-row label{
    display:block; font-size:.72rem; font-weight:600;
    text-transform:uppercase; letter-spacing:.04em;
    color:var(--muted); margin-bottom:6px;
  }
  .search-row .search-input-wrap{position:relative;}
  .search-row .search-icon{
    position:absolute; left:13px; top:50%; transform:translateY(-50%);
    color:var(--muted); pointer-events:none; font-size:.95rem;
    transition:color .15s ease;
  }
  .search-row input{
    width:100%;
    padding:12px 14px 12px 38px;
    border-radius:12px;
    border:1.5px solid var(--border);
    background:var(--surface-2);
    color:var(--text);
    font-family:inherit;
    font-size:.92rem;
    transition:border-color .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .search-row input::placeholder{color:var(--muted);}
  .search-row input:hover{border-color:var(--accent-2);}
  .search-row input:focus{
    outline:none;
    border-color:var(--accent);
    background:var(--surface);
    box-shadow:0 0 0 4px var(--accent-soft);
  }
  .search-row .search-input-wrap:focus-within .search-icon{color:var(--accent);}

  .sheet-row{display:flex; flex-direction:column; gap:6px;}
  .sheet-row label{
    display:block; font-size:.72rem; font-weight:600;
    text-transform:uppercase; letter-spacing:.04em;
    color:var(--muted);
  }
  .sheet-row .filter-group{position:relative;}
  .sheet-filter-btn{
    width:100%;
    display:flex; align-items:center; justify-content:space-between;
    padding:11px 12px;
    border-radius:11px;
    border:1px solid var(--border);
    background:var(--surface-2);
    color:var(--text);
    font-family:inherit;
    font-size:.92rem;
    font-weight:600;
    cursor:pointer;
    transition:border-color .15s ease, box-shadow .15s ease;
  }
  .sheet-filter-btn::after{content:'▾'; color:var(--muted); margin-left:8px;}
  .sheet-filter-btn:hover{border-color:var(--accent-2);}
  .sheet-filter-btn.active{border-color:var(--accent); color:var(--accent);}
  .sheet-filter-btn:focus-visible{
    outline:none;
    border-color:var(--accent);
    box-shadow:0 0 0 3px var(--accent-soft);
  }

  .filter-buttons{display:flex; flex-wrap:wrap; gap:8px; align-items:center;}
  .filter-group{position:relative;}
  .filter-btn{
    display:flex;
    align-items:center;
    gap:6px;
    padding:7px 12px;
    border-radius:999px;
    border:1px solid var(--border);
    background:var(--surface-2);
    color:var(--text);
    font-family:inherit;
    font-size:.82rem;
    font-weight:500;
    cursor:pointer;
    transition:border-color .15s ease, background .15s ease, color .15s ease;
  }
  .filter-btn:hover{border-color:var(--accent-2);}
  .filter-btn.active{border-color:var(--accent); color:var(--accent); background:var(--accent-soft);}
  .filter-btn .count{
    background:var(--accent);
    color:#fff;
    border-radius:999px;
    font-size:.66rem;
    font-weight:600;
    padding:1px 6px;
  }

  /* Chip-based, same as the Interview Mode modal (§ chip-group) — no
     internal scroll. Wide enough that even Sheet (16 values) or Topic (22
     values) wrap into a handful of rows instead of needing to scroll. */
  .filter-popover{
    display:none;
    position:absolute;
    top:calc(100% + 8px);
    left:0;
    z-index:30;
    width:min(360px, 88vw);
    background:var(--surface-3);
    border:1px solid var(--border);
    border-radius:12px;
    padding:12px;
    box-shadow:var(--shadow);
  }
  .filter-popover.open{display:block;}
  .filter-popover .fp-search{
    width:100%;
    padding:8px 11px;
    margin-bottom:10px;
    border-radius:8px;
    border:1.5px solid var(--border);
    background:var(--surface-2);
    color:var(--text);
    font-family:inherit;
    font-size:.82rem;
    transition:border-color .15s ease;
  }
  .filter-popover .fp-search::placeholder{color:var(--muted);}
  .filter-popover .fp-search:focus{outline:none; border-color:var(--accent);}
  .filter-popover .chip-group{margin-bottom:10px;}
  .filter-popover .fp-actions{
    display:flex;
    gap:8px;
    padding-top:10px;
    border-top:1px solid var(--border);
  }
  .filter-popover .fp-actions button{flex:1;}

  button.btn{
    padding:10px 18px;
    border-radius:10px;
    border:none;
    background:var(--accent);
    color:#fff;
    font-family:inherit;
    font-size:.85rem;
    font-weight:600;
    cursor:pointer;
    box-shadow:var(--shadow-sm);
    transition:background .15s ease, transform .1s ease, box-shadow .15s ease;
  }
  button.btn:hover{background:var(--accent-2); box-shadow:0 4px 14px -4px var(--accent-soft);}
  button.btn:active{transform:translateY(1px);}
  button.btn.ghost{
    background:transparent;
    border:1px solid var(--border);
    color:var(--text);
    box-shadow:none;
  }
  button.btn.ghost:hover{border-color:var(--accent-2); color:var(--accent-2); background:var(--accent-soft);}
  button.btn.small{padding:6px 11px; font-size:.78rem; border-radius:8px;}
  button.btn:disabled{opacity:.4; cursor:not-allowed; transform:none; box-shadow:none;}

  .status-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    font-size:.82rem;
    color:var(--muted);
    padding:14px 18px;
  }
  .status-row .status-text{font-weight:500;}
  .clear-link{
    background:none; border:none; color:var(--accent); font-family:inherit;
    font-size:.82rem; font-weight:600; cursor:pointer; padding:4px;
  }
  .clear-link:hover{color:var(--accent-2); text-decoration:underline;}

  .empty,.note{
    text-align:center;
    color:var(--muted);
    font-size:.88rem;
    padding:32px 16px;
  }
  .empty .empty-icon{font-size:1.8rem; display:block; margin-bottom:8px;}
  .note.error{color:var(--danger);}
  .answer-missing{color:var(--muted); font-style:italic;}

  /* ---------- Java syntax highlighting (Coding sheet only) ---------- */
  .code-block{
    display:block;
    background:var(--code-bg);
    color:var(--code-fg);
    border-radius:10px;
    padding:12px 14px;
    font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
    font-size:.82rem;
    line-height:1.55;
    white-space:pre-wrap;
    overflow-wrap:break-word;
  }
  .tok-kw{color:var(--code-kw); font-weight:600;}
  .tok-str{color:var(--code-str);}
  .tok-num{color:var(--code-num);}
  .tok-com{color:var(--code-com); font-style:italic;}
  .tok-ann{color:var(--code-ann);}
  .tok-type{color:var(--code-type);}

  /* A lone "OR" line in an Answer cell, separating two alternate answer
     phrasings (see docs/RULES.md section 4) -- centered/italic/uppercase
     divider instead of a plain text line. */
  .answer-or-sep{text-align:center; font-style:italic; font-weight:700; text-transform:uppercase; color:var(--muted); margin:6px 0;}

  /* ---------- desktop: excel-style table (no scrollers — columns wrap instead) ---------- */
  #tableView{display:none; padding:0; overflow:hidden;}
  .table-wrap{width:100%;}
  table{width:100%; table-layout:fixed; border-collapse:collapse;}
  thead th{
    position:sticky; top:0;
    background:var(--surface-2);
    text-align:left;
    font-size:.72rem;
    font-weight:600;
    letter-spacing:.05em;
    text-transform:uppercase;
    color:var(--muted);
    padding:13px 14px;
    border-bottom:1px solid var(--border);
    overflow-wrap:break-word;
  }
  tbody td{
    padding:14px;
    border-bottom:1px solid var(--border);
    font-size:.86rem;
    line-height:1.5;
    vertical-align:top;
    overflow-wrap:break-word;
  }
  tbody tr:last-child td{border-bottom:none;}
  tbody tr{transition:background .1s ease;}
  tbody tr:hover{background:var(--surface-2);}
  td.col-meta, th.col-meta{width:160px;}
  td.col-question, th.col-question{width:34%;}
  td.col-answer, th.col-answer{width:auto; white-space:pre-wrap;}
  .q-priority{margin-top:6px; display:flex; flex-wrap:wrap; gap:6px;}
  .meta-grid{display:flex; flex-direction:column; gap:6px;}
  .meta-row{display:flex; flex-wrap:wrap; gap:6px; align-items:center;}
  .meta-row .tag{max-width:100%; white-space:normal; overflow-wrap:break-word; text-align:left;}
  .tag{
    display:inline-flex;
    font-size:.72rem;
    font-weight:600;
    padding:4px 10px;
    border-radius:999px;
    white-space:nowrap;
  }
  .tag-category{background:var(--tag-cat-bg); color:var(--tag-cat-fg);}
  .tag-level{background:var(--tag-lvl-bg); color:var(--tag-lvl-fg);}
  .tag-priority{background:var(--tag-pri-bg); color:var(--tag-pri-fg);}
  .tag-sheet{background:var(--tag-sheet-bg); color:var(--tag-sheet-fg);}
  .tag-company{background:var(--tag-company-bg); color:var(--tag-company-fg);}
  /* Wrapper for possibly-multiple company tags (comma-separated in Excel,
     see docs/RULES.md section 5) -- display:contents makes its children
     participate directly in the parent .q-priority flex row instead of
     being boxed inside this wrapper. */
  .company-tags{display:contents;}

  /* ---------- mobile: one record at a time ---------- */
  #singleView{display:none; flex-direction:column; gap:14px;}
  .field-row{display:flex; flex-direction:column; gap:4px;}
  .field-row .field-label{font-size:.7rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--muted);}
  .field-row .field-value{font-size:.95rem;}
  .field-row.q .field-value{font-weight:600; font-size:1.1rem; line-height:1.5;}
  .field-row.a .field-value{white-space:pre-wrap; line-height:1.65; background:var(--surface-2); border:1px solid var(--border); border-radius:12px; padding:14px; font-size:.9rem;}
  .field-inline{display:flex; gap:6px; flex-wrap:wrap;}
  .pager{display:flex; justify-content:space-between; gap:10px;}
  .pager .btn{flex:1;}

  /* ---------- Listen Mode: one record at a time, read aloud ---------- */
  #listenView{display:none; flex-direction:column; gap:14px;}
  .listen-status{color:var(--muted); font-size:.82rem; text-align:center;}
  .listen-controls{display:flex; flex-direction:column; gap:12px; padding-top:6px; border-top:1px solid var(--border);}

  @media (min-width:768px){
    #tableView{display:block;}
    #singleView{display:none !important;}
  }
  @media (max-width:767.98px){
    #tableView{display:none !important;}
    #singleView{display:flex;}

    /* Topic/Level/Priority/Answer popovers anchor (left:0) to their own
       pill button's group -- fine on desktop, but on a narrow screen a
       pill sitting mid-row (e.g. Priority/Answer) put the popover's left
       edge wherever that pill was, running the fixed-width panel off the
       right side of the viewport. Repositioning the containing block to
       the whole row instead of the individual pill keeps the popover
       fully on-screen regardless of which pill opened it. */
    .filter-buttons{position:relative;}
    .filter-buttons .filter-group{position:static;}
    .filter-buttons .filter-popover{left:0; right:0; width:auto;}
  }
  @media (max-width:480px){
    header h1{font-size:1.15rem;}
    .card{padding:14px; border-radius:14px;}
    .header-actions{width:100%;}
  }
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="brand">
      <div class="brand-mark">📚</div>
      <div>
        <h1>Interview Prep Hub</h1>
        <p id="headerSubtitle">Loading…</p>
      </div>
    </div>
    <div class="header-actions">
      <div class="mode-toggle" role="tablist" aria-label="Mode">
        <button id="normalModeBtn" class="mode-btn active" type="button" role="tab" aria-selected="true">📖 <span class="label-full">Normal Mode</span><span class="label-short">Normal</span></button>
        <button id="listenModeBtn" class="mode-btn" type="button" role="tab" aria-selected="false">🎧 <span class="label-full">Listen Mode</span><span class="label-short">Listen</span></button>
        <button id="interviewOpenBtn" class="mode-btn" type="button" role="tab" aria-selected="false">🎯 <span class="label-full">Interview Mode</span><span class="label-short">Interview</span></button>
      </div>
      <button id="historyOpenBtn" type="button" class="header-icon-btn" aria-label="Interview session history" title="Interview session history">🕘 <span class="label-full">History</span></button>
      <button id="themeToggle" type="button" aria-label="Theme mode (click to cycle Auto / Light / Dark)" title="◐ Auto follows your system light/dark setting.&#10;☀ Light always uses light mode.&#10;☾ Dark always uses dark mode.&#10;(Click to cycle)"><span class="theme-icon" id="themeIcon">🌙</span><span class="label-full" id="themeLabelFull">Dark Mode</span><span class="label-short" id="themeLabelShort">Dark</span></button>
    </div>
  </header>

  <div class="card toolbar">
    <div class="sheet-row">
      <label for="sheetFilterBtn">Sheet</label>
      <div class="filter-group">
        <button id="sheetFilterBtn" class="sheet-filter-btn" type="button">All Sheets</button>
        <div class="filter-popover" id="sheetFilterPopover" data-col="sheet"></div>
      </div>
    </div>
    <div class="search-row">
      <label for="search">Search question / answer</label>
      <div class="search-input-wrap">
        <span class="search-icon">🔍</span>
        <input id="search" type="text" placeholder="Type to search...">
      </div>
    </div>
    <div class="filter-buttons" id="filterButtons"></div>
  </div>

  <div class="card status-row">
    <span class="status-text" id="statusText">0 questions</span>
    <button class="clear-link" id="clearFiltersBtn" type="button">Clear Filters</button>
  </div>

  <!-- Interview Mode: configuration modal -->
  <div class="modal-overlay" id="interviewModal" style="display:none;">
    <div class="modal card">
      <div class="modal-header">
        <h2>🎯 Interview Mode</h2>
        <button class="modal-close" id="interviewCloseBtn" type="button" aria-label="Close">✕</button>
      </div>
      <p class="modal-sub">Pick what to draw from, how many, and how, then start.</p>

      <div class="modal-section">
        <span class="modal-section-label">Presets</span>
        <div class="preset-row">
          <select id="interviewPresetSelect" class="modal-select">
            <option value="">— Select a saved preset —</option>
          </select>
          <button class="btn ghost small" id="interviewPresetSaveBtn" type="button">Save Current</button>
          <button class="btn ghost small" id="interviewPresetDeleteBtn" type="button">Delete</button>
          <button class="btn small" id="interviewPresetStartBtn" type="button">Start</button>
        </div>
      </div>

      <details class="modal-section voice-details" id="interviewVoiceSection" style="display:none;">
        <summary class="modal-section-label">Voice settings ▾</summary>
        <div class="toggle-grid-2">
          <div id="interviewVoiceSubBlock" style="display:none;">
            <label class="voice-sub-label" for="interviewVoiceSelect">Question voice (Read Aloud)</label>
            <select id="interviewVoiceSelect" class="modal-select"></select>
          </div>
          <div id="interviewSttLangSubBlock" style="display:none;">
            <label class="voice-sub-label" for="interviewSttLangSelect">Your answer's language/accent</label>
            <select id="interviewSttLangSelect" class="modal-select">
              <option value="en-US">English (US)</option>
              <option value="en-GB">English (UK)</option>
              <option value="en-IN">English (India)</option>
              <option value="en-AU">English (Australia)</option>
              <option value="hi-IN">Hindi (हिन्दी)</option>
            </select>
          </div>
        </div>
      </details>

      <div class="modal-section">
        <span class="modal-section-label">Sheets</span>
        <div class="chip-group" id="interviewSheetList"></div>
      </div>

      <div class="modal-section">
        <span class="modal-section-label">Level</span>
        <div class="chip-group" id="interviewLevelList"></div>
      </div>

      <div class="modal-section">
        <span class="modal-section-label">Priority</span>
        <div class="chip-group" id="interviewPriorityList"></div>
      </div>

      <div class="modal-grid-2">
        <div class="modal-section">
          <span class="modal-section-label">Question count</span>
          <input type="text" inputmode="numeric" pattern="[0-9]*" id="interviewCountInput"
                 class="modal-select count-input" list="interviewCountPresets">
          <datalist id="interviewCountPresets"></datalist>
          <span class="match-hint" id="interviewMatchHint"></span>
        </div>
        <div class="modal-section">
          <span class="modal-section-label">Order</span>
          <label class="modal-toggle-row">
            <input type="checkbox" id="interviewRandomize" checked>
            <span>Random order</span>
          </label>
        </div>
      </div>

      <div class="modal-section">
        <span class="modal-section-label">Mix &amp; Extras</span>
        <div class="toggle-grid-2">
          <label class="modal-toggle-row" title="Even split of your question count across the sheets you selected, instead of skewing toward whichever has more rows.">
            <input type="checkbox" id="interviewBalancedMix">
            <span>Balanced Mix</span>
          </label>
          <label class="modal-toggle-row" title="Favor sheets you've drilled less or scored worse on, based on your session History.">
            <input type="checkbox" id="interviewPrioritizeWeak">
            <span>Prioritize Weak Sheets</span>
          </label>
          <label class="modal-toggle-row" title="Write your own answer before revealing the real one.">
            <input type="checkbox" id="interviewScratchToggle">
            <span>Scratch box for your answer</span>
          </label>
          <label class="modal-toggle-row" title="Speaks each question aloud automatically using your selected voice.">
            <input type="checkbox" id="interviewAutoRead">
            <span>Auto-read questions aloud</span>
          </label>
          <label class="modal-toggle-row" title="Speech-to-text: your spoken answer is transcribed into the scratch box (Chrome/Edge only).">
            <input type="checkbox" id="interviewVoiceAnswer">
            <span>Answer by voice</span>
          </label>
          <label class="modal-toggle-row" title="Rule-based 0-10 score on Reveal (length, keyword overlap vs. the reference answer, filler words) -- not AI.">
            <input type="checkbox" id="interviewScoreAnswers">
            <span>Score my answers</span>
          </label>
        </div>
        <p class="modal-hint" id="voiceUnsupportedNote" style="display:none;">🔇 Some voice features are hidden — your browser doesn't support them. Try Chrome or Edge.</p>
      </div>

      <div class="modal-error" id="interviewError" style="display:none;"></div>

      <div class="modal-actions">
        <button class="btn ghost" id="interviewCancelBtn" type="button">Cancel</button>
        <button class="btn" id="interviewStartBtn" type="button">Start Interview</button>
      </div>
    </div>
  </div>

  <!-- Interview session history: a local, per-browser log of past sessions
       (date, config used, question count, duration) -- NOT scoring/
       correctness tracking, just a record that a session happened. -->
  <div class="modal-overlay" id="historyModal" style="display:none;">
    <div class="modal card">
      <div class="modal-header">
        <h2>🕘 Interview History</h2>
        <button class="modal-close" id="historyCloseBtn" type="button" aria-label="Close">✕</button>
      </div>
      <p class="modal-sub">Past practice sessions, stored locally in this browser.</p>

      <div id="historyList"></div>
      <div class="modal-empty" id="historyEmpty" style="display:none;">No sessions yet — finish or end an Interview Mode session to see it here.</div>

      <div class="modal-actions">
        <button class="btn ghost" id="historyClearBtn" type="button">Clear History</button>
        <button class="btn" id="historyCloseFooterBtn" type="button">Close</button>
      </div>
    </div>
  </div>

  <!-- Interview Mode: active session, one question at a time -->
  <div class="card" id="interviewView" style="display:none;">
    <div class="interview-topbar">
      <span class="status-text" id="interviewProgress">Question 1 of 1</span>
      <span class="interview-timer" id="interviewTimer">00:00</span>
      <button class="icon-toggle-btn" id="iSpeakBtn" type="button" title="Read question aloud (R)">🔊</button>
      <select id="iVoiceSelect" class="voice-select" title="Voice for Read Aloud"></select>
      <button class="icon-toggle-btn" id="iFocusBtn" type="button" title="Focus Mode" aria-pressed="false">🧘</button>
      <button class="clear-link" id="interviewEndBtn" type="button">End Interview</button>
    </div>

    <div id="interviewCard">
      <div class="field-inline">
        <span class="tag tag-sheet" id="iSheet"></span>
        <span class="tag tag-category" id="iCategory"></span>
        <span class="tag tag-level" id="iLevel"></span>
      </div>
      <div class="field-row q">
        <span class="field-label">Question</span>
        <div id="iQuestionList"></div>
      </div>
      <div class="q-priority"><span class="tag tag-priority" id="iPriority"></span><span class="company-tags" id="iCompany"></span></div>
      <div class="field-row" id="iScratchRow" style="display:none;">
        <span class="field-label">Your answer</span>
        <div class="scratch-row">
          <textarea id="iScratch" class="scratch-box" placeholder="Jot (or speak) your own answer here first — kept only for this session, not saved to Excel..."></textarea>
          <button class="icon-toggle-btn" id="iMicBtn" type="button" title="Answer by voice" style="display:none;">🎤</button>
          <button class="icon-toggle-btn" id="iScratchClearBtn" type="button" title="Clear your answer">🗑️</button>
        </div>
        <span class="mic-status" id="iMicStatus" style="display:none;">🔴 Listening…</span>
        <div class="score-result" id="iScoreResult" style="display:none;"></div>
      </div>
      <div class="field-row a" id="iAnswerRow" style="display:none;">
        <span class="field-label">A:</span>
        <span class="field-value" id="iAnswer"></span>
      </div>
      <button class="btn" id="iRevealBtn" type="button">Reveal Answer</button>
      <div class="pager">
        <button class="btn ghost" id="iPrevBtn" type="button">Previous</button>
        <button class="btn" id="iNextBtn" type="button">Next</button>
      </div>
    </div>

    <div id="interviewDone" style="display:none;">
      <div class="empty">
        <span class="empty-icon">🏁</span>
        Interview complete — you went through every question in this session.
      </div>
      <div id="interviewScoreSummary" style="display:none;">
        <div class="score-overall" id="interviewOverallScore"></div>
        <div id="interviewScoreBreakdown"></div>
      </div>
      <div class="modal-actions">
        <button class="btn ghost" id="interviewExportBtn" type="button" style="display:none;">Export .txt</button>
        <button class="btn ghost" id="interviewExitBtn" type="button">Exit to Browse</button>
        <button class="btn ghost" id="interviewRepeatBtn" type="button">Repeat Same Questions</button>
        <button class="btn" id="interviewRestartBtn" type="button">Restart Same Session</button>
      </div>
    </div>
  </div>

  <!-- Desktop: excel-style table, all matching rows -->
  <div class="card" id="tableView">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="col-meta">Details</th>
            <th class="col-question">Question</th>
            <th class="col-answer">Answer</th>
          </tr>
        </thead>
        <tbody id="tableBody"></tbody>
      </table>
    </div>
  </div>

  <!-- Mobile: one record at a time, every field always visible, with pagination -->
  <div class="card" id="singleView">
    <div class="field-inline">
      <span class="tag tag-sheet" id="mSheet"></span>
      <span class="tag tag-category" id="mCategory"></span>
      <span class="tag tag-level" id="mLevel"></span>
    </div>
    <div class="field-row q">
      <span class="field-label">Question</span>
      <span class="field-value" id="mQuestion"></span>
    </div>
    <div class="q-priority"><span class="tag tag-priority" id="mPriority"></span><span class="company-tags" id="mCompany"></span></div>
    <div class="field-row a">
      <span class="field-label">Answer</span>
      <span class="field-value" id="mAnswer"></span>
    </div>
    <div class="pager">
      <button class="btn ghost" id="prevBtn" type="button">Previous</button>
      <button class="btn" id="nextBtn" type="button">Next</button>
    </div>
  </div>

  <!-- Listen Mode: same filtered pool as Normal Mode, one record read
       aloud at a time via speechSynthesis instead of read by eye. -->
  <div class="card" id="listenView" style="display:none;">
    <div class="field-inline">
      <span class="tag tag-sheet" id="lSheet"></span>
      <span class="tag tag-category" id="lCategory"></span>
      <span class="tag tag-level" id="lLevel"></span>
    </div>
    <div class="field-row q">
      <span class="field-label">Question</span>
      <span class="field-value" id="lQuestion"></span>
    </div>
    <div class="q-priority"><span class="tag tag-priority" id="lPriority"></span><span class="company-tags" id="lCompany"></span></div>
    <div class="field-row a">
      <span class="field-label">Answer</span>
      <span class="field-value" id="lAnswer"></span>
    </div>
    <div class="listen-status" id="listenStatus"></div>
    <div class="listen-controls">
      <div class="pager">
        <button class="btn ghost" id="listenPrevBtn" type="button">Previous</button>
        <button class="btn" id="listenPlayBtn" type="button">▶ Play</button>
        <button class="btn ghost" id="listenNextBtn" type="button">Next</button>
      </div>
      <label class="modal-toggle-row">
        <input type="checkbox" id="listenAutoAdvance" checked>
        Continue to next question automatically
      </label>
      <div>
        <label class="voice-sub-label" for="lVoiceSelect">Voice</label>
        <select id="lVoiceSelect" class="voice-select"></select>
      </div>
    </div>
  </div>

  <div class="card empty" id="emptyState" style="display:none;">
    <span class="empty-icon">🗂️</span>
    No questions match the current filters.
  </div>
  <div class="card note" id="loadingNote">Loading questions...</div>
</div>

<script>
(function(){
  "use strict";

  var DATA = [];

  // Sheet (real Excel tab name) gets its own dedicated popover/trigger
  // above Search (see buildFilterButtons()), while Topic/Level/Priority/
  // Answer render as pills below. Category/Topic is a separate,
  // finer-grained field from Sheet — see RULES.md §2 for why these must
  // stay distinct.
  var FILTER_COLUMNS = [
    { key: 'sheet', label: 'Sheet' },
    { key: 'category', label: 'Topic' },
    { key: 'level', label: 'Level' },
    { key: 'priority', label: 'Priority' },
    { key: 'company', label: 'Company' },
    { key: 'answer', label: 'Answer' }
  ];

  var allQuestions = DATA;
  var filteredQuestions = [];
  var currentIndex = 0;

  // null = no restriction (all values shown); Set = only these values shown
  var columnFilters = { sheet: null, category: null, level: null, priority: null, company: null, answer: null };
  var openPopoverCol = null;

  // Interview Mode: separate session state, independent of the browse
  // filters above. sheets/priorities are Sets of allowed values (never
  // null here — always built explicitly from the checked boxes).
  var interviewQuestions = [];
  var interviewIndex = 0;
  var interviewAnswers = []; // parallel to interviewQuestions: { answerText, score, feedback }
  var lastInterviewConfig = null; // { sheets: Set, levels: Set, priorities: Set, randomize: bool, count: number|null } for "Restart Same Session"

  var els = {
    headerSubtitle: document.getElementById('headerSubtitle'),
    themeToggle: document.getElementById('themeToggle'),
    themeIcon: document.getElementById('themeIcon'),
    themeLabelFull: document.getElementById('themeLabelFull'),
    themeLabelShort: document.getElementById('themeLabelShort'),
    search: document.getElementById('search'),
    filterButtons: document.getElementById('filterButtons'),
    sheetFilterBtn: document.getElementById('sheetFilterBtn'),
    sheetFilterPopover: document.getElementById('sheetFilterPopover'),
    statusText: document.getElementById('statusText'),
    clearFiltersBtn: document.getElementById('clearFiltersBtn'),
    tableView: document.getElementById('tableView'),
    tableBody: document.getElementById('tableBody'),
    singleView: document.getElementById('singleView'),
    mSheet: document.getElementById('mSheet'),
    mCategory: document.getElementById('mCategory'),
    mLevel: document.getElementById('mLevel'),
    mPriority: document.getElementById('mPriority'),
    mCompany: document.getElementById('mCompany'),
    mQuestion: document.getElementById('mQuestion'),
    mAnswer: document.getElementById('mAnswer'),
    prevBtn: document.getElementById('prevBtn'),
    nextBtn: document.getElementById('nextBtn'),
    emptyState: document.getElementById('emptyState'),
    loadingNote: document.getElementById('loadingNote'),

    listenView: document.getElementById('listenView'),
    lSheet: document.getElementById('lSheet'),
    lCategory: document.getElementById('lCategory'),
    lLevel: document.getElementById('lLevel'),
    lPriority: document.getElementById('lPriority'),
    lCompany: document.getElementById('lCompany'),
    lQuestion: document.getElementById('lQuestion'),
    lAnswer: document.getElementById('lAnswer'),
    listenStatus: document.getElementById('listenStatus'),
    listenPrevBtn: document.getElementById('listenPrevBtn'),
    listenPlayBtn: document.getElementById('listenPlayBtn'),
    listenNextBtn: document.getElementById('listenNextBtn'),
    listenAutoAdvance: document.getElementById('listenAutoAdvance'),
    lVoiceSelect: document.getElementById('lVoiceSelect'),

    normalModeBtn: document.getElementById('normalModeBtn'),
    listenModeBtn: document.getElementById('listenModeBtn'),
    interviewOpenBtn: document.getElementById('interviewOpenBtn'),
    interviewModal: document.getElementById('interviewModal'),
    interviewCloseBtn: document.getElementById('interviewCloseBtn'),
    interviewCancelBtn: document.getElementById('interviewCancelBtn'),
    interviewStartBtn: document.getElementById('interviewStartBtn'),
    interviewSheetList: document.getElementById('interviewSheetList'),
    interviewLevelList: document.getElementById('interviewLevelList'),
    interviewPriorityList: document.getElementById('interviewPriorityList'),
    interviewCountInput: document.getElementById('interviewCountInput'),
    interviewMatchHint: document.getElementById('interviewMatchHint'),
    interviewCountPresets: document.getElementById('interviewCountPresets'),
    interviewRandomize: document.getElementById('interviewRandomize'),
    interviewBalancedMix: document.getElementById('interviewBalancedMix'),
    interviewPrioritizeWeak: document.getElementById('interviewPrioritizeWeak'),
    interviewScratchToggle: document.getElementById('interviewScratchToggle'),
    interviewAutoRead: document.getElementById('interviewAutoRead'),
    interviewVoiceAnswer: document.getElementById('interviewVoiceAnswer'),
    interviewScoreAnswers: document.getElementById('interviewScoreAnswers'),
    voiceUnsupportedNote: document.getElementById('voiceUnsupportedNote'),
    interviewError: document.getElementById('interviewError'),
    interviewPresetSelect: document.getElementById('interviewPresetSelect'),
    interviewPresetSaveBtn: document.getElementById('interviewPresetSaveBtn'),
    interviewPresetDeleteBtn: document.getElementById('interviewPresetDeleteBtn'),
    interviewPresetStartBtn: document.getElementById('interviewPresetStartBtn'),

    interviewView: document.getElementById('interviewView'),
    interviewProgress: document.getElementById('interviewProgress'),
    interviewTimer: document.getElementById('interviewTimer'),
    interviewEndBtn: document.getElementById('interviewEndBtn'),
    interviewCard: document.getElementById('interviewCard'),
    interviewDone: document.getElementById('interviewDone'),
    interviewExitBtn: document.getElementById('interviewExitBtn'),
    interviewRepeatBtn: document.getElementById('interviewRepeatBtn'),
    interviewRestartBtn: document.getElementById('interviewRestartBtn'),
    interviewExportBtn: document.getElementById('interviewExportBtn'),
    interviewScoreSummary: document.getElementById('interviewScoreSummary'),
    interviewOverallScore: document.getElementById('interviewOverallScore'),
    interviewScoreBreakdown: document.getElementById('interviewScoreBreakdown'),
    iSheet: document.getElementById('iSheet'),
    iCategory: document.getElementById('iCategory'),
    iLevel: document.getElementById('iLevel'),
    iPriority: document.getElementById('iPriority'),
    iCompany: document.getElementById('iCompany'),
    iQuestionList: document.getElementById('iQuestionList'),
    iScratchRow: document.getElementById('iScratchRow'),
    iScratch: document.getElementById('iScratch'),
    iMicBtn: document.getElementById('iMicBtn'),
    iScratchClearBtn: document.getElementById('iScratchClearBtn'),
    iMicStatus: document.getElementById('iMicStatus'),
    iScoreResult: document.getElementById('iScoreResult'),
    iAnswerRow: document.getElementById('iAnswerRow'),
    iAnswer: document.getElementById('iAnswer'),
    iRevealBtn: document.getElementById('iRevealBtn'),
    iPrevBtn: document.getElementById('iPrevBtn'),
    iNextBtn: document.getElementById('iNextBtn'),
    iSpeakBtn: document.getElementById('iSpeakBtn'),
    iVoiceSelect: document.getElementById('iVoiceSelect'),
    iFocusBtn: document.getElementById('iFocusBtn'),
    interviewVoiceSection: document.getElementById('interviewVoiceSection'),
    interviewVoiceSubBlock: document.getElementById('interviewVoiceSubBlock'),
    interviewVoiceSelect: document.getElementById('interviewVoiceSelect'),
    interviewSttLangSubBlock: document.getElementById('interviewSttLangSubBlock'),
    interviewSttLangSelect: document.getElementById('interviewSttLangSelect'),

    historyOpenBtn: document.getElementById('historyOpenBtn'),
    historyModal: document.getElementById('historyModal'),
    historyCloseBtn: document.getElementById('historyCloseBtn'),
    historyCloseFooterBtn: document.getElementById('historyCloseFooterBtn'),
    historyClearBtn: document.getElementById('historyClearBtn'),
    historyList: document.getElementById('historyList'),
    historyEmpty: document.getElementById('historyEmpty')
  };

  // ---------- theme: Auto / Light / Dark ----------
  // 'Auto' isn't just "whatever the OS said on page load" -- it keeps
  // tracking the OS preference live for as long as the tab stays open
  // (via the matchMedia listener below), same as a native app's "Auto"
  // theme setting would. 'Light'/'Dark' pin the scheme regardless of OS.

  function currentThemeMode(){
    try{
      var mode = localStorage.getItem('theme');
      return (mode === 'light' || mode === 'dark') ? mode : 'auto';
    }catch(e){ return 'auto'; }
  }

  function resolvedSchemeForMode(mode){
    if(mode === 'light' || mode === 'dark') return mode;
    return (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
  }

  // Re-applies the resolved scheme for whatever mode is currently active
  // (without changing the mode itself) -- used both after an explicit
  // mode change and by the live OS-preference listener while in Auto.
  function applyResolvedTheme(){
    var mode = currentThemeMode();
    document.documentElement.setAttribute('data-theme', resolvedSchemeForMode(mode));
    applyThemeIcon(mode);
  }

  function applyThemeIcon(mode){
    var icon = mode === 'auto' ? '◐' : (mode === 'light' ? '☀️' : '🌙');
    var labelFull = mode === 'auto' ? 'Auto Theme' : (mode === 'light' ? 'Light Mode' : 'Dark Mode');
    var labelShort = mode === 'auto' ? 'Auto' : (mode === 'light' ? 'Light' : 'Dark');
    els.themeIcon.textContent = icon;
    els.themeLabelFull.textContent = labelFull;
    els.themeLabelShort.textContent = labelShort;
  }

  function setThemeMode(mode){
    try{ localStorage.setItem('theme', mode); }catch(e){}
    applyResolvedTheme();
  }

  function cycleTheme(){
    var order = ['auto', 'light', 'dark'];
    var next = order[(order.indexOf(currentThemeMode()) + 1) % order.length];
    setThemeMode(next);
  }

  function escapeHtml(str){
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // ---------- Java syntax highlighting (Coding sheet answers only) ----------

  var JAVA_KEYWORDS = ['public','private','protected','static','final','void','class','new',
    'return','if','else','for','while','do','switch','case','default','break','continue',
    'try','catch','finally','throw','throws','import','package','extends','implements',
    'interface','enum','this','super','null','true','false','int','long','short','byte',
    'char','boolean','float','double','String','instanceof','var','abstract','synchronized',
    'volatile','transient','native'];

  var JAVA_TOKEN_RE = new RegExp(
    '(?<comment>\\/\\/[^\\n]*|\\/\\*[\\s\\S]*?\\*\\/)' +
    '|(?<string>"(?:\\\\.|[^"\\\\])*")' +
    '|(?<char>\'(?:\\\\.|[^\'\\\\])*\')' +
    '|(?<annotation>@\\w+)' +
    '|(?<number>\\b\\d+(?:\\.\\d+)?[fFdDlL]?\\b)' +
    '|(?<keyword>\\b(?:' + JAVA_KEYWORDS.join('|') + ')\\b)' +
    '|(?<type>\\b[A-Z][A-Za-z0-9_]*\\b)',
    'g'
  );

  function javaHighlight(text){
    JAVA_TOKEN_RE.lastIndex = 0;
    var out = '';
    var lastIndex = 0;
    var m;
    while((m = JAVA_TOKEN_RE.exec(text))){
      if(m.index > lastIndex){
        out += escapeHtml(text.slice(lastIndex, m.index));
      }
      var cls = m.groups.comment ? 'tok-com' :
        (m.groups.string || m.groups.char) ? 'tok-str' :
        m.groups.annotation ? 'tok-ann' :
        m.groups.number ? 'tok-num' :
        m.groups.keyword ? 'tok-kw' :
        m.groups.type ? 'tok-type' : null;
      out += cls ? '<span class="' + cls + '">' + escapeHtml(m[0]) + '</span>' : escapeHtml(m[0]);
      lastIndex = JAVA_TOKEN_RE.lastIndex;
      if(m.index === JAVA_TOKEN_RE.lastIndex) JAVA_TOKEN_RE.lastIndex++;
    }
    out += escapeHtml(text.slice(lastIndex));
    return out;
  }

  function unescapeHtml(str){
    var div = document.createElement('div');
    div.innerHTML = str;
    return div.textContent;
  }

  // extract_data.py wraps a ```-fenced Question/Answer code block in
  // <pre class="code-block" data-highlight="pending"> with plain escaped
  // text inside (see docs/RULES.md section 4) -- this applies the same
  // javaHighlight() tokenizer the Coding sheet uses, so both paths render
  // with identical coloring, then drops the pending marker.
  var PENDING_CODE_RE = /<pre class="code-block" data-highlight="pending">([\s\S]*?)<\/pre>/g;
  function highlightFencedCode(html){
    return html.replace(PENDING_CODE_RE, function(_, escaped){
      return '<pre class="code-block">' + javaHighlight(unescapeHtml(escaped)) + '</pre>';
    });
  }

  // Rows with more than one phrasing ("What is X? or Why choose X?") were
  // originally joined into one line with "or" for browse mode. The user
  // asked for them stacked one below another instead -- but explicitly
  // NOT with Interview Mode's "Q." label prefix (that's a Interview-mode-
  // only convention, not something asked for here). So browse mode just
  // stacks each phrasing as its own plain line, no label, no "or".
  // Single-phrasing questions (the majority) render unchanged.
  function questionPartsHtml(q){
    var parts = (q.questionParts && q.questionParts.length) ? q.questionParts : [q.question];
    if(parts.length === 1) return highlightFencedCode(parts[0]);
    return '<div class="q-parts">' + parts.map(function(part){
      return '<div class="q-line">' + highlightFencedCode(part) + '</div>';
    }).join('') + '</div>';
  }

  // Many rows in the source Excel don't have an answer written yet (~62%
  // of the current dataset) — show a clearly-muted placeholder instead of
  // an empty area, so it reads as "not written yet" rather than "broken".
  // Coding-sheet answers render as a syntax-highlighted Java code block
  // instead of prose, since that's literally what they are.
  function answerHtmlOrPlaceholder(q){
    if(!q.answerPlain || !q.answerPlain.trim()){
      return '<span class="answer-missing">No answer added in Excel yet.</span>';
    }
    if(q.sheet === 'Coding'){
      return '<pre class="code-block">' + javaHighlight(q.answerPlain) + '</pre>';
    }
    return highlightFencedCode(q.answer);
  }

  // Level values sort in ascending years-of-experience order (Fresher ->
  // Junior to Mid -> Mid -> Senior -> Lead / Architect -> General last,
  // since it has no years attached) instead of alphabetically -- matches
  // extract_data.py's YEARS_BAND_LEVEL band order (§3/§7 in RULES.md).
  // Anything not in this list (shouldn't happen given the extraction
  // rule, but kept as a safety net) sorts after the known bands.
  var LEVEL_SORT_ORDER = ['Fresher', 'Junior to Mid', 'Mid', 'Senior', 'Lead / Architect', 'General'];

  function levelSortIndex(val){
    var base = val.split(' (')[0];
    var idx = LEVEL_SORT_ORDER.indexOf(base);
    return idx === -1 ? LEVEL_SORT_ORDER.length : idx;
  }

  // Company supports multiple values in one Excel cell, comma-separated
  // (a question asked at more than one company) -- everywhere else treats
  // a filter column as one exact value per row, but Company splits into
  // its own list so filtering by either company matches the row and each
  // one renders as its own tag (docs/RULES.md section 5 Company note).
  function companyList(q){
    return (q.company || '').split(',').map(function(s){ return s.trim(); }).filter(Boolean);
  }

  function companyTagsHtml(q){
    var list = companyList(q);
    if(list.length === 0) return '<span class="tag tag-company">—</span>';
    return list.map(function(c){ return '<span class="tag tag-company">' + escapeHtml(c) + '</span>'; }).join('');
  }

  // Browse-mode's Topic/Level/Priority/Company popover options are scoped
  // to the currently selected Sheet(s) -- picking HR as Sheet shows only
  // HR's own Topics/Levels/Priorities/Companies, not every value across
  // all six sheets. One-directional (Sheet narrows the rest, not the
  // other way around): Sheet's own popover always lists every sheet
  // regardless of any other active filter.
  function sheetScopedQuestions(){
    if(!columnFilters.sheet) return allQuestions;
    return allQuestions.filter(function(q){ return columnFilters.sheet.has(q.sheet); });
  }

  // ignoreSheetScope: Interview Mode's own Sheet/Level chip pickers are a
  // separate, independent selection from browse-mode's Sheet filter (a
  // different screen/state entirely) -- they must always list every value
  // across all sheets, never silently narrowed by whatever Sheet filter
  // happens to be active in browse mode. Pass true from those call sites.
  function uniqueValues(key, ignoreSheetScope){
    var source = (key === 'sheet' || ignoreSheetScope) ? allQuestions : sheetScopedQuestions();
    if(key === 'company'){
      var companyVals = [];
      source.forEach(function(q){
        var list = companyList(q);
        companyVals = companyVals.concat(list.length ? list : ['(blank)']);
      });
      return Array.from(new Set(companyVals)).sort();
    }
    var vals = source.map(function(q){ return q[key] || '(blank)'; });
    var unique = Array.from(new Set(vals));
    if(key === 'level'){
      unique.sort(function(a, b){
        var diff = levelSortIndex(a) - levelSortIndex(b);
        return diff !== 0 ? diff : a.localeCompare(b);
      });
      return unique;
    }
    return unique.sort();
  }

  // ---------- filter toolbar (Excel-style column filters, incl. Sheet) ----------

  // Sheet gets its own dedicated row above Search (its own button/popover,
  // built directly in HTML); Topic/Level/Priority render as pills in the
  // .filter-buttons row. Both trigger types share the same popover
  // open/close/render machinery via this lookup, built once.
  var popoverRefs = {};

  function buildFilterButtons(){
    els.filterButtons.innerHTML = '';
    popoverRefs = {
      sheet: { btn: els.sheetFilterBtn, pop: els.sheetFilterPopover }
    };

    FILTER_COLUMNS.forEach(function(col){
      if(col.key === 'sheet') return; // has its own dedicated row, not a pill
      var group = document.createElement('div');
      group.className = 'filter-group';

      var btn = document.createElement('button');
      btn.className = 'filter-btn';
      btn.type = 'button';
      btn.dataset.col = col.key;
      btn.innerHTML = escapeHtml(col.label) + ' ▾';
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        togglePopover(col.key);
      });

      var pop = document.createElement('div');
      pop.className = 'filter-popover';
      pop.dataset.col = col.key;
      pop.addEventListener('click', function(e){ e.stopPropagation(); });

      group.appendChild(btn);
      group.appendChild(pop);
      els.filterButtons.appendChild(group);

      popoverRefs[col.key] = { btn: btn, pop: pop };
    });

    els.sheetFilterBtn.addEventListener('click', function(e){
      e.stopPropagation();
      togglePopover('sheet');
    });
    els.sheetFilterPopover.addEventListener('click', function(e){ e.stopPropagation(); });

    document.addEventListener('click', function(){ closeAllPopovers(); });
  }

  function closeAllPopovers(){
    openPopoverCol = null;
    document.querySelectorAll('.filter-popover').forEach(function(p){ p.classList.remove('open'); });
    document.querySelectorAll('.filter-btn, .sheet-filter-btn').forEach(function(b){ b.classList.remove('active'); });
  }

  function togglePopover(colKey){
    var willOpen = openPopoverCol !== colKey;
    closeAllPopovers();
    if(!willOpen) return;
    openPopoverCol = colKey;

    var ref = popoverRefs[colKey];
    renderFilterPopoverChips(colKey, ref.pop);
    ref.pop.classList.add('open');
    ref.btn.classList.add('active');
  }

  // Chip-based (no internal scroll) — same component as the Interview
  // Mode modal, reusing buildChipGroup()/chipGroupSelected(). Restores
  // whatever's currently applied in columnFilters[colKey] so reopening a
  // popover doesn't lose a prior selection.
  // Synthetic Priority chip value, not a real Excel value -- see
  // NON_BLANK_PRIORITY's matching special-case in applyFilters(). Browse
  // mode's Priority filter otherwise still shows every raw value as its
  // own chip (unchanged, per RULES.md) -- this is one added chip on top,
  // not a replacement/bucketing of the raw list.
  var NON_BLANK_PRIORITY = 'Non Blank';

  // 'answer' isn't a categorical field like the others (it's long free-form
  // rich text, one HTML string per row) -- there's no meaningful "unique
  // values" list to build chips from, so this filter is always exactly
  // these two synthetic buckets instead of going through uniqueValues().
  // Matched in applyFilters() against whether answerPlain is empty.
  var ANSWER_FILTER_VALUES = ['Blank', 'Non Blank'];

  function renderFilterPopoverChips(colKey, pop){
    var values;
    if(colKey === 'answer'){
      values = ANSWER_FILTER_VALUES;
    } else {
      values = uniqueValues(colKey);
      if(colKey === 'priority') values = [NON_BLANK_PRIORITY].concat(values);
    }
    var selected = columnFilters[colKey]; // null = wildcard ("All")
    pop.innerHTML = '';

    // Topic (category) alone can run to 100+ distinct values -- a search
    // box narrows the chip list live as you type, so you don't have to
    // scan/scroll a huge list to multi-select a few. Other filter groups
    // (Sheet/Level/Priority) stay small enough that a search box would
    // just be clutter, so this is scoped to 'category' only.
    if(colKey === 'category'){
      var searchInput = document.createElement('input');
      searchInput.type = 'text';
      searchInput.className = 'fp-search';
      searchInput.placeholder = 'Search topics...';
      pop.appendChild(searchInput);
    }

    var chipGroupEl = document.createElement('div');
    chipGroupEl.className = 'chip-group';
    pop.appendChild(chipGroupEl);
    var group = buildChipGroup(chipGroupEl, values, 'All', selected);

    if(colKey === 'category'){
      searchInput.addEventListener('input', function(){
        var term = searchInput.value.trim().toLowerCase();
        group.chips.forEach(function(c){
          c.style.display = c.dataset.value.toLowerCase().indexOf(term) === -1 ? 'none' : '';
        });
      });
    }

    var actions = document.createElement('div');
    actions.className = 'fp-actions';

    var clearBtn = document.createElement('button');
    clearBtn.type = 'button';
    clearBtn.className = 'btn ghost small';
    clearBtn.textContent = 'Clear';
    clearBtn.addEventListener('click', function(){
      columnFilters[colKey] = null;
      closeAllPopovers();
      applyFilters();
    });

    var applyBtn = document.createElement('button');
    applyBtn.type = 'button';
    applyBtn.className = 'btn small';
    applyBtn.textContent = 'Apply';
    applyBtn.addEventListener('click', function(){
      var picked = chipGroupSelected(group); // null or array
      columnFilters[colKey] = picked === null ? null : new Set(picked);
      closeAllPopovers();
      applyFilters();
    });

    actions.appendChild(clearBtn);
    actions.appendChild(applyBtn);
    pop.appendChild(actions);
  }

  function updateFilterButtonStates(){
    FILTER_COLUMNS.forEach(function(col){
      var ref = popoverRefs[col.key];
      if(!ref) return;
      var sel = columnFilters[col.key];
      var active = sel !== null;
      ref.btn.classList.toggle('active', active);

      if(col.key === 'sheet'){
        if(!active){
          ref.btn.textContent = 'All Sheets';
        } else if(sel.size === 1){
          ref.btn.textContent = Array.from(sel)[0];
        } else {
          ref.btn.textContent = sel.size + ' Sheets';
        }
        return;
      }

      var countBadge = ref.btn.querySelector('.count');
      if(active){
        if(!countBadge){
          countBadge = document.createElement('span');
          countBadge.className = 'count';
          ref.btn.appendChild(countBadge);
        }
        countBadge.textContent = sel.size;
      } else if(countBadge){
        countBadge.remove();
      }
    });
  }

  // ---------- filtering + rendering ----------

  function applyFilters(){
    var searchTerms = els.search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);

    filteredQuestions = allQuestions.filter(function(q){
      var haystack = (q.questionPlain || '').toLowerCase() + ' ' + (q.answerPlain || '').toLowerCase();
      var matchesSearch = searchTerms.every(function(term){
        return haystack.indexOf(term) !== -1;
      });

      var matchesCols = FILTER_COLUMNS.every(function(col){
        var sel = columnFilters[col.key];
        if(sel === null) return true;
        // 'answer' has no real per-row value to compare -- it's whether
        // answerPlain is empty or not, matched against the two synthetic
        // ANSWER_FILTER_VALUES buckets instead of q[col.key] directly.
        if(col.key === 'answer'){
          var hasAnswer = !!(q.answerPlain && q.answerPlain.trim());
          return sel.has(hasAnswer ? 'Non Blank' : 'Blank');
        }
        // Company can hold several comma-separated values in one row --
        // matches if ANY of them is selected, not the whole raw string.
        if(col.key === 'company'){
          var companies = companyList(q);
          if(companies.length === 0) return sel.has('(blank)');
          return companies.some(function(c){ return sel.has(c); });
        }
        var val = q[col.key] || '(blank)';
        // Non Blank isn't a real value in the data -- it means "any
        // priority at all", so it matches on top of (not instead of)
        // whichever specific values are also checked in the same group.
        if(col.key === 'priority' && sel.has(NON_BLANK_PRIORITY) && val !== '(blank)') return true;
        return sel.has(val);
      });

      return matchesSearch && matchesCols;
    });

    currentIndex = 0;
    updateFilterButtonStates();

    if(filteredQuestions.length === 0){
      els.emptyState.style.display = 'block';
      els.tableBody.innerHTML = '';
      // Hide both browse views so a stale previously-rendered question
      // (mobile single-card) or an empty header-only table (desktop)
      // doesn't linger next to the "no matches" message. Reset to '' (not
      // left as 'none') as soon as results reappear below, so the CSS
      // media-query rules stay in control — same pattern as the
      // Interview Mode display-reset bug, see endInterview().
      els.tableView.style.display = 'none';
      els.singleView.style.display = 'none';
      if(listenModeActive) refreshListenView();
      updateStatus();
      return;
    }

    els.emptyState.style.display = 'none';
    // Listen Mode replaces table/single entirely while active -- leave
    // them hidden (goListenMode() already set that) and refresh the
    // current listen question instead, rather than re-showing both views
    // underneath it.
    if(listenModeActive){
      refreshListenView();
    } else {
      els.tableView.style.display = '';
      els.singleView.style.display = '';
      renderTable();
      renderSingle();
    }
    updateStatus();
  }

  function updateStatus(){
    var total = filteredQuestions.length;
    els.statusText.textContent = total === 0 ? '0 questions' :
      (total + ' question' + (total === 1 ? '' : 's') + ' matched');
  }

  // Desktop: excel-style table, every matching row shown at once.
  function renderTable(){
    els.tableBody.innerHTML = '';
    filteredQuestions.forEach(function(q){
      var tr = document.createElement('tr');

      // Sheet/Category/Level merged into one column (three stacked rows of
      // tag badges) so Question/Answer get most of the row width. Sr.No
      // isn't shown -- the user found a per-question serial number didn't
      // look good, and it's not useful revision info anyway (Interview
      // Mode already excludes it for the same reason). Priority lives with
      // the Question instead (see below) -- it's the one field the user
      // wants to stand out, not blend into this list.
      var tdMeta = document.createElement('td');
      tdMeta.className = 'col-meta';
      tdMeta.innerHTML =
        '<div class="meta-grid">' +
          '<div class="meta-row">' +
            '<span class="tag tag-sheet">' + escapeHtml(q.sheet) + '</span>' +
          '</div>' +
          '<div class="meta-row">' +
            '<span class="tag tag-category">' + escapeHtml(q.category) + '</span>' +
          '</div>' +
          '<div class="meta-row">' +
            '<span class="tag tag-level">' + escapeHtml(q.level) + '</span>' +
          '</div>' +
        '</div>';

      // Priority renders as its own line directly below the question text
      // -- moved out of the Details column so it stands out next to the
      // thing it's actually about, instead of getting lost among the
      // other small meta tags. Sits AFTER the question (not before) so
      // the question is read first, priority second.
      var tdQuestion = document.createElement('td');
      tdQuestion.className = 'col-question';
      tdQuestion.innerHTML =
        '<div class="q-text">' + questionPartsHtml(q) + '</div>' +
        '<div class="q-priority"><span class="tag tag-priority">' + escapeHtml(q.priority || '—') +
        '</span>' + companyTagsHtml(q) + '</div>';

      var tdAnswer = document.createElement('td');
      tdAnswer.className = 'col-answer';
      tdAnswer.innerHTML = answerHtmlOrPlaceholder(q);

      tr.appendChild(tdMeta);
      tr.appendChild(tdQuestion);
      tr.appendChild(tdAnswer);
      els.tableBody.appendChild(tr);
    });
  }

  // Mobile: one record at a time, every field always visible, Previous/Next pagination.
  function renderSingle(){
    var q = filteredQuestions[currentIndex];
    els.mSheet.textContent = q.sheet;
    els.mCategory.textContent = q.category;
    els.mLevel.textContent = q.level;
    els.mPriority.textContent = q.priority || '—';
    els.mCompany.innerHTML = companyTagsHtml(q);
    els.mQuestion.innerHTML = questionPartsHtml(q);
    els.mAnswer.innerHTML = answerHtmlOrPlaceholder(q);

    els.prevBtn.disabled = currentIndex === 0;
    els.nextBtn.disabled = currentIndex === filteredQuestions.length - 1;
  }

  function goPrev(){
    if(currentIndex > 0){ currentIndex--; renderSingle(); updateStatus(); }
  }
  function goNext(){
    if(currentIndex < filteredQuestions.length - 1){ currentIndex++; renderSingle(); updateStatus(); }
  }

  function clearAllFilters(){
    columnFilters = { sheet: null, category: null, level: null, priority: null, company: null, answer: null };
    els.search.value = '';
    applyFilters();
  }

  // ---------- Interview Mode ----------

  function shuffle(arr){
    var a = arr.slice();
    for(var i = a.length - 1; i > 0; i--){
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
  }

  // Compact chip multi-select — replaces the old vertical checkbox list.
  // Returns the array of value chips; use chipGroupSelected() to read state.
  // By default (exclusive=true) the wildcard chip ("All"/"Random") and the
  // individual value chips are mutually exclusive: by default only the
  // wildcard is lit up (meaning "no filter, include everything") — the
  // individual chips start neutral, NOT all pre-lit as if every one had
  // been hand-picked (that was the confusing part: opening the modal made
  // all 16 sheets look individually selected). Clicking any individual
  // chip switches the group into manual mode (wildcard turns off, that
  // chip turns on); clicking the wildcard chip always resets the group
  // back to "everything", clearing manual picks.
  // initialSelected: omit/null for the default "wildcard on, nothing
  // individually picked" state; pass a Set to restore a previously-applied
  // selection (used when reopening a browse-mode filter popover).
  // exclusive: pass false to let the wildcard and individual chips be
  // toggled freely together (e.g. Interview Mode's Priority group, so
  // "🎲 Random" can be combined with "LinkedIn" etc. — chipGroupSelected()
  // still reads wildcard-on as "matches everything" regardless of which
  // individual chips are also lit, since Random is a superset of any of
  // them; this makes combining them harmless rather than needing to be
  // disallowed).
  function buildChipGroup(container, values, allLabel, initialSelected, exclusive){
    if(exclusive === undefined) exclusive = true;
    container.innerHTML = '';
    var wildcardOn = (initialSelected === undefined || initialSelected === null);

    var allChip = document.createElement('button');
    allChip.type = 'button';
    allChip.className = 'chip chip-all' + (wildcardOn ? ' selected' : '');
    allChip.textContent = allLabel || 'All';
    container.appendChild(allChip);

    var chips = [];
    values.forEach(function(val){
      var chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'chip' + (!wildcardOn && initialSelected.has(val) ? ' selected' : '');
      chip.textContent = val;
      chip.dataset.value = val;
      container.appendChild(chip);
      chips.push(chip);
    });

    allChip.addEventListener('click', function(){
      if(exclusive){
        allChip.classList.add('selected');
        chips.forEach(function(c){ c.classList.remove('selected'); });
      } else {
        allChip.classList.toggle('selected');
      }
    });
    chips.forEach(function(c){
      c.addEventListener('click', function(){
        if(exclusive) allChip.classList.remove('selected');
        c.classList.toggle('selected');
      });
    });

    return { allChip: allChip, chips: chips };
  }

  // Returns null when the wildcard chip is active (no filter — include
  // every value, regardless of which individual chips are ALSO lit in a
  // non-exclusive group — wildcard is a superset of any of them), otherwise
  // the array of individually-selected values (may be empty, meaning the
  // user manually deselected everything).
  function chipGroupSelected(group){
    if(group.allChip.classList.contains('selected')) return null;
    return group.chips.filter(function(c){ return c.classList.contains('selected'); }).map(function(c){ return c.dataset.value; });
  }

  var interviewSheetChips = [];
  var interviewLevelChips = [];
  var interviewPriorityChips = [];

  // Interview Mode's Priority selector groups the raw Excel "Priority
  // Count" values into a few meaningful buckets instead of listing every
  // distinct raw value (0/1/2/3/4/7, LinkedIn-1, Linkedin-2, ...) as its
  // own chip -- the exact counts/spelling variants aren't meaningful for
  // picking a practice set, "has this been asked on LinkedIn" / "does it
  // have any recorded count at all" is. Browse mode's Priority filter
  // popover still shows every raw value as its own chip (unchanged), plus
  // one added synthetic 'Non Blank' chip (see NON_BLANK_PRIORITY) -- see
  // RULES.md.
  var PRIORITY_BUCKETS = ['Blank', 'Not Blank', 'LinkedIn', 'Count'];

  function priorityBucketsFor(priorityRaw){
    var val = (priorityRaw || '').trim();
    if(!val) return ['Blank'];
    var buckets = ['Not Blank'];
    if(/^linkedin/i.test(val)) buckets.push('LinkedIn');
    if(/^\d+$/.test(val)) buckets.push('Count');
    return buckets;
  }

  var COUNT_STEPS = [5, 10, 15, 20, 25, 30, 40, 50];

  // Question count is a free-typed number (any value from 1 up to the
  // matching pool size), not a fixed dropdown -- the user explicitly
  // asked why they couldn't type their own number. COUNT_STEPS still
  // seeds the <datalist> so common values remain one click away in
  // browsers that show datalist suggestions, but any number can be typed.
  // Leaving the field blank means "All".
  function populateCountPresets(){
    var max = allQuestions.length;
    var options = COUNT_STEPS.filter(function(n){ return n < max; })
      .map(function(n){ return '<option value="' + n + '"></option>'; });
    els.interviewCountPresets.innerHTML = options.join('');
  }

  // ---------- Interview config presets (localStorage, per-browser) ----------
  // Saves the WHOLE modal state (Sheets/Level/Priority picks, count,
  // Random order, Balanced Mix, Prioritize Weak Sheets, scratch box) under
  // a name, so a session can be reconfigured with one pick from the
  // dropdown instead of rebuilding chips/toggles every time.
  var INTERVIEW_PRESETS_KEY = 'interviewPresets';

  function loadInterviewPresets(){
    try{
      var raw = localStorage.getItem(INTERVIEW_PRESETS_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch(e){
      return []; // localStorage unavailable -- presets are a convenience, never block the app
    }
  }

  function saveInterviewPresetsList(list){
    try{ localStorage.setItem(INTERVIEW_PRESETS_KEY, JSON.stringify(list)); } catch(e){ /* ignore */ }
  }

  function populateInterviewPresetSelect(){
    var presets = loadInterviewPresets();
    var options = ['<option value="">— Select a saved preset —</option>'];
    presets.forEach(function(p, i){
      options.push('<option value="' + i + '">' + escapeHtml(p.name) + '</option>');
    });
    els.interviewPresetSelect.innerHTML = options.join('');
  }

  function currentInterviewModalState(){
    var countRaw = els.interviewCountInput.value.trim();
    return {
      sheets: chipGroupSelected(interviewSheetChips),       // array or null (wildcard)
      levels: chipGroupSelected(interviewLevelChips),
      priorities: chipGroupSelected(interviewPriorityChips),
      count: (countRaw !== '' && /^\d+$/.test(countRaw)) ? parseInt(countRaw, 10) : null,
      randomize: els.interviewRandomize.checked,
      balancedMix: els.interviewBalancedMix.checked,
      prioritizeWeak: els.interviewPrioritizeWeak.checked,
      showScratch: els.interviewScratchToggle.checked,
      autoRead: els.interviewAutoRead.checked,
      voiceAnswer: els.interviewVoiceAnswer.checked,
      scoreAnswers: els.interviewScoreAnswers.checked
    };
  }

  function applyInterviewPreset(preset){
    interviewSheetChips = buildChipGroup(els.interviewSheetList, uniqueValues('sheet'), 'All',
      preset.sheets ? new Set(preset.sheets) : null);
    interviewLevelChips = buildChipGroup(els.interviewLevelList, uniqueValues('level', true), '🎲 Random',
      preset.levels ? new Set(preset.levels) : null);
    interviewPriorityChips = buildChipGroup(els.interviewPriorityList, PRIORITY_BUCKETS, '🎲 Random',
      preset.priorities ? new Set(preset.priorities) : null, false);
    els.interviewCountInput.value = (preset.count === null || preset.count === undefined) ? '' : String(preset.count);
    els.interviewRandomize.checked = !!preset.randomize;
    els.interviewBalancedMix.checked = !!preset.balancedMix;
    els.interviewPrioritizeWeak.checked = !!preset.prioritizeWeak;
    els.interviewScratchToggle.checked = !!preset.showScratch;
    els.interviewAutoRead.checked = !!preset.autoRead;
    els.interviewVoiceAnswer.checked = !!preset.voiceAnswer;
    els.interviewScoreAnswers.checked = !!preset.scoreAnswers;
  }

  // Saving over an existing name overwrites that preset (no silent
  // duplicates cluttering the dropdown) rather than appending a second
  // entry with the same name.
  function saveCurrentInterviewPreset(){
    var name = window.prompt('Name this preset:', '');
    if(!name) return; // cancelled or left blank -- nothing saved
    name = name.trim();
    if(!name) return;

    var state = currentInterviewModalState();
    var presets = loadInterviewPresets();
    var existingIndex = -1;
    for(var i = 0; i < presets.length; i++){
      if(presets[i].name === name){ existingIndex = i; break; }
    }
    var entry = {
      name: name,
      sheets: state.sheets, levels: state.levels, priorities: state.priorities,
      count: state.count, randomize: state.randomize, balancedMix: state.balancedMix,
      prioritizeWeak: state.prioritizeWeak, showScratch: state.showScratch,
      autoRead: state.autoRead, voiceAnswer: state.voiceAnswer, scoreAnswers: state.scoreAnswers
    };
    if(existingIndex !== -1) presets[existingIndex] = entry;
    else presets.push(entry);
    saveInterviewPresetsList(presets);
    populateInterviewPresetSelect();
    els.interviewPresetSelect.value = String(existingIndex !== -1 ? existingIndex : presets.length - 1);
  }

  function loadSelectedInterviewPreset(){
    var idx = els.interviewPresetSelect.value;
    if(idx === '') return;
    var preset = loadInterviewPresets()[parseInt(idx, 10)];
    if(!preset) return;
    applyInterviewPreset(preset);
    updateInterviewLiveFeedback();
  }

  function deleteSelectedInterviewPreset(){
    var idx = els.interviewPresetSelect.value;
    if(idx === '') return;
    var presets = loadInterviewPresets();
    presets.splice(parseInt(idx, 10), 1);
    saveInterviewPresetsList(presets);
    populateInterviewPresetSelect();
  }

  // Live feedback while configuring: matching-question count + which
  // sections still need input. Same "missing" rule as startInterviewFromModal():
  // an explicitly emptied chip group is missing, the wildcard is fine;
  // a blank count is missing.
  function countMatchingInterviewQuestions(sheets, levels, priorities){
    var cfg = {
      sheets: sheets === null ? null : new Set(sheets),
      levels: levels === null ? null : new Set(levels),
      priorities: priorities === null ? null : new Set(priorities)
    };
    return allQuestions.filter(function(q){
      var sheetOk = cfg.sheets === null || cfg.sheets.has(q.sheet || '(blank)');
      return sheetOk && matchesInterviewLevelPriority(q, cfg);
    }).length;
  }

  function markSection(container, missing){
    var section = container.closest('.modal-section');
    if(section) section.classList.toggle('needs-input', missing);
  }

  function updateInterviewLiveFeedback(){
    var sheets = chipGroupSelected(interviewSheetChips);
    var levels = chipGroupSelected(interviewLevelChips);
    var priorities = chipGroupSelected(interviewPriorityChips);
    var countRaw = els.interviewCountInput.value.trim();

    var sheetMissing = sheets !== null && sheets.length === 0;
    var levelMissing = levels !== null && levels.length === 0;
    var priorityMissing = priorities !== null && priorities.length === 0;
    var countMissing = countRaw === '';
    markSection(els.interviewSheetList, sheetMissing);
    markSection(els.interviewLevelList, levelMissing);
    markSection(els.interviewPriorityList, priorityMissing);
    markSection(els.interviewCountInput, countMissing);
    els.interviewStartBtn.disabled = sheetMissing || levelMissing || priorityMissing || countMissing;

    var n = countMatchingInterviewQuestions(sheets, levels, priorities);
    els.interviewMatchHint.textContent = n + ' question' + (n === 1 ? '' : 's') + ' match your filters';
  }

  function openInterviewModal(){
    pauseListen(); // don't keep reading aloud behind the config modal
    els.interviewError.style.display = 'none';
    // Nothing pre-selected, not even the wildcard -- user must choose.
    interviewSheetChips = buildChipGroup(els.interviewSheetList, uniqueValues('sheet'), 'All', new Set());
    interviewLevelChips = buildChipGroup(els.interviewLevelList, uniqueValues('level', true), '🎲 Random', new Set());
    interviewPriorityChips = buildChipGroup(els.interviewPriorityList, PRIORITY_BUCKETS, '🎲 Random', new Set(), false);
    populateCountPresets();
    els.interviewCountInput.value = '';
    els.interviewRandomize.checked = false;
    els.interviewBalancedMix.checked = false;
    els.interviewPrioritizeWeak.checked = false;
    els.interviewScratchToggle.checked = false;
    els.interviewAutoRead.checked = false;
    els.interviewVoiceAnswer.checked = false;
    els.interviewScoreAnswers.checked = false;
    els.interviewSttLangSelect.value = getSttLang();
    populateInterviewPresetSelect();
    updateInterviewLiveFeedback();
    els.interviewModal.style.display = 'flex';
  }

  function closeInterviewModal(){
    els.interviewModal.style.display = 'none';
  }

  function startInterviewFromModal(){
    // null = wildcard active ("no filter" — every value included);
    // an array (possibly empty) = the user is manually picking values.
    var sheets = chipGroupSelected(interviewSheetChips);
    var levels = chipGroupSelected(interviewLevelChips);
    var priorities = chipGroupSelected(interviewPriorityChips);
    var randomize = els.interviewRandomize.checked;
    var balancedMix = els.interviewBalancedMix.checked;
    var prioritizeWeak = els.interviewPrioritizeWeak.checked;
    var showScratch = els.interviewScratchToggle.checked;
    var autoRead = els.interviewAutoRead.checked;
    var voiceAnswer = els.interviewVoiceAnswer.checked;
    var scoreAnswers = els.interviewScoreAnswers.checked;
    var countRaw = els.interviewCountInput.value.trim();
    // Whole numbers only, matched against the raw string -- parseInt()
    // alone would silently truncate "5.7" to 5 with no feedback that the
    // decimal was dropped, which reads as the input ignoring what was
    // typed rather than rejecting it.
    var count = countRaw === '' ? null : (/^\d+$/.test(countRaw) ? parseInt(countRaw, 10) : NaN);

    // The wildcard "All"/"🎲 Random" chip is ACTIVE BY DEFAULT the instant
    // the modal opens, before the user touches anything -- so there is no
    // way to tell "deliberately clicked All" apart from "never touched
    // it, still on its default" (both leave the group at null, and look
    // visually identical). Requiring the wildcard to not count as a valid
    // choice was tried and immediately confusing: the user clicked All,
    // saw it highlighted, and still got "Select a Sheet" — reverted.
    // Question count is different -- blank is visibly, unambiguously
    // "not filled in" (no default-active state to confuse it with), so
    // that part of "every filter must be explicit" still holds. Reports
    // every missing field at once, not just the first one hit.
    var missing = [];
    if(sheets !== null && sheets.length === 0) missing.push('a Sheet');
    if(levels !== null && levels.length === 0) missing.push('a Level');
    if(priorities !== null && priorities.length === 0) missing.push('a Priority');
    if(countRaw === '') missing.push('a Question count');

    if(missing.length){
      // Natural "a, b and c" join instead of a flat comma list, and no
      // restating of the wildcard/blank-count rule every time -- that
      // explanation belongs in the docs, not a message shown on every
      // single validation failure regardless of which fields are
      // actually missing.
      var missingText = missing.length === 1 ? missing[0] :
        missing.slice(0, -1).join(', ') + ' and ' + missing[missing.length - 1];
      els.interviewError.textContent = 'Select ' + missingText + ' before starting.';
      els.interviewError.style.display = 'block';
      return;
    }

    if(!Number.isInteger(count) || count < 1){
      els.interviewError.textContent = 'Question count must be a whole number of 1 or more.';
      els.interviewError.style.display = 'block';
      return;
    }

    var config = {
      sheets: sheets === null ? null : new Set(sheets),
      levels: levels === null ? null : new Set(levels),
      priorities: priorities === null ? null : new Set(priorities),
      randomize: randomize,
      balancedMix: balancedMix,
      prioritizeWeak: prioritizeWeak,
      showScratch: showScratch,
      autoRead: autoRead,
      voiceAnswer: voiceAnswer,
      scoreAnswers: scoreAnswers,
      count: count
    };
    var pool = buildInterviewPool(config);

    if(pool.length === 0){
      els.interviewError.textContent = 'No questions match that combination. Try selecting more sheets/levels/priorities.';
      els.interviewError.style.display = 'block';
      return;
    }

    lastInterviewConfig = config;
    closeInterviewModal();
    launchInterview(pool);
  }

  // Shared by both buildInterviewPool() branches -- everything except the
  // sheet check, so per-sheet balanced-mix pools and the plain combined
  // pool apply the exact same Level/Priority filtering.
  function matchesInterviewLevelPriority(q, config){
    var levelVal = q.level || '(blank)';
    var levelOk = config.levels === null || config.levels.has(levelVal);
    var priorityOk = config.priorities === null ||
      priorityBucketsFor(q.priority).some(function(b){ return config.priorities.has(b); });
    return levelOk && priorityOk;
  }

  // How many past sessions (from the localStorage history log) drew on
  // each sheet, used by Prioritize Weak Sheets below. A session's config
  // records the CHECKED sheets, not which sheet each individual question
  // came from -- so this approximates per-sheet drill count by splitting
  // each session's reachedCount evenly across the sheets it drew from
  // (or every real sheet, if that session used the Sheets wildcard).
  // Good enough for biasing a quota, not meant to be exact.
  function computeSheetDrillCounts(){
    var history = loadInterviewHistory();
    var counts = {};
    history.forEach(function(entry){
      var sheets = entry.sheets || uniqueValues('sheet');
      if(!sheets.length) return;
      var share = (entry.reachedCount || 0) / sheets.length;
      sheets.forEach(function(s){ counts[s] = (counts[s] || 0) + share; });
    });
    return counts;
  }

  // Average past score per sheet, from history entries that had scoring
  // on (older entries/sessions without it just don't contribute -- no
  // score data isn't treated as "scored 0"). Used to also weight
  // Prioritize Weak Sheets toward sheets you've scored poorly on, not
  // just ones you've drilled less.
  function computeSheetPerformance(){
    var history = loadInterviewHistory();
    var bySheet = {};
    history.forEach(function(entry){
      if(!entry.sheetScores) return;
      Object.keys(entry.sheetScores).forEach(function(s){
        if(!bySheet[s]) bySheet[s] = { total: 0, count: 0 };
        bySheet[s].total += entry.sheetScores[s];
        bySheet[s].count++;
      });
    });
    var avg = {};
    Object.keys(bySheet).forEach(function(s){ avg[s] = bySheet[s].total / bySheet[s].count; });
    return avg;
  }

  // Largest-remainder allocation: gives each sheet a share of totalCount
  // proportional to its weight, floors each share, then hands out
  // whatever's left (from the floor rounding) to the sheets with the
  // largest fractional remainder -- so the quotas always sum to exactly
  // totalCount instead of drifting from repeated rounding-down.
  function allocateWeightedQuotas(weights, totalCount){
    var weightSum = weights.reduce(function(a, b){ return a + b; }, 0);
    var raw = weights.map(function(w){ return weightSum > 0 ? (w / weightSum) * totalCount : 0; });
    var floors = raw.map(Math.floor);
    var allocated = floors.reduce(function(a, b){ return a + b; }, 0);
    var remaining = totalCount - allocated;
    var byRemainder = raw.map(function(v, i){ return { i: i, frac: v - floors[i] }; })
      .sort(function(a, b){ return b.frac - a.frac; });
    for(var k = 0; k < remaining && byRemainder.length; k++){
      floors[byRemainder[k % byRemainder.length].i]++;
    }
    return floors;
  }

  // Balanced Mix / Prioritize Weak Sheets: instead of pooling every
  // matching question across all selected sheets and shuffling (which
  // skews toward whichever sheet has more rows banked -- CoreJava's 320
  // vs Coding's 70, say), split the requested count ACROSS sheets first,
  // then pick that many at random FROM each sheet independently. Only
  // changes which questions are selected, not the config.randomize
  // toggle's separate job of shuffling final presentation order (below).
  // Requires a specific count -- with count left blank ("All"), every
  // matching question is included either way, so there's nothing to
  // split, weighted or not.
  function buildBalancedInterviewPool(config){
    var sheetList = config.sheets === null ? uniqueValues('sheet') : Array.from(config.sheets);
    if(!config.count){
      // No count to split across sheets -- same result set as the plain
      // path, just still grouped/filtered per sheet for consistency.
      return allQuestions.filter(function(q){
        var sheetVal = q.sheet || '(blank)';
        return sheetList.indexOf(sheetVal) !== -1 && matchesInterviewLevelPriority(q, config);
      });
    }

    var order, quotas;
    if(config.prioritizeWeak){
      // Sheet order doesn't need shuffling here -- the weighting itself
      // (not which sheet gets an arbitrary "+1") determines the bias.
      // Laplace-smoothed inverse frequency: never-drilled sheets get
      // weight 1 (the max), heavily-drilled sheets approach 0 but never
      // hit it outright (so a well-drilled sheet can still show up, just
      // rarely, rather than being excluded once it's been practiced).
      order = sheetList.slice();
      var drillCounts = computeSheetDrillCounts();
      var performance = computeSheetPerformance();
      var weights = order.map(function(s){
        var base = 1 / (1 + (drillCounts[s] || 0));
        // No score history for this sheet -> neutral (factor 1, drill
        // count alone decides it). A low past average score multiplies
        // the weight up to 2x (at avg 0); a perfect 10 average leaves it
        // unchanged -- scoring worse never REDUCES a sheet's chances.
        var scoreFactor = (s in performance) ? 1 + (10 - performance[s]) / 10 : 1;
        return base * scoreFactor;
      });
      quotas = allocateWeightedQuotas(weights, config.count);
    } else {
      // Shuffle which sheets get the "+1" from an uneven even split, so
      // it's not always the same sheets (e.g. alphabetically-first ones)
      // favored.
      order = shuffle(sheetList);
      var base = Math.floor(config.count / order.length);
      var remainder = config.count % order.length;
      quotas = order.map(function(_, i){ return base + (i < remainder ? 1 : 0); });
    }

    var picked = [];
    order.forEach(function(sheetVal, i){
      var quota = quotas[i];
      if(quota <= 0) return;
      var sheetPool = allQuestions.filter(function(q){
        return (q.sheet || '(blank)') === sheetVal && matchesInterviewLevelPriority(q, config);
      });
      picked = picked.concat(shuffle(sheetPool).slice(0, quota));
      // A sheet with fewer matching questions than its quota just
      // contributes what it has -- the total can end up short of
      // config.count rather than over-filling from other sheets, same
      // as a real interviewer running out of prepared questions in one
      // area rather than padding it from elsewhere.
    });
    return picked;
  }

  function buildInterviewPool(config){
    var pool;

    // Prioritize Weak Sheets implies the same per-sheet-quota routing as
    // Balanced Mix (it's a variant of the same mechanism, just weighted
    // instead of even) -- checking it works standalone, without also
    // checking Balanced Mix.
    if(config.balancedMix || config.prioritizeWeak){
      pool = buildBalancedInterviewPool(config);
      // Both variants' per-sheet quotas above are always randomly
      // selected regardless of this flag (see buildBalancedInterviewPool)
      // -- Random order here only decides whether the picks are then
      // interleaved (checked) or stay grouped sheet-by-sheet in the
      // order they were picked in (unchecked).
      if(config.randomize) pool = shuffle(pool);
      return pool;
    }

    pool = allQuestions.filter(function(q){
      var sheetVal = q.sheet || '(blank)';
      var sheetOk = config.sheets === null || config.sheets.has(sheetVal);
      return sheetOk && matchesInterviewLevelPriority(q, config);
    });
    // Shuffling before slicing (not after) is what makes "N random
    // questions" actually random instead of always the same first N of
    // the filtered set -- see RULES.md §7.
    if(config.randomize) pool = shuffle(pool);
    if(config.count && config.count < pool.length) pool = pool.slice(0, config.count);
    return pool;
  }

  var interviewTimerHandle = null;
  var interviewStartTime = null;

  function pad2(n){ return n < 10 ? '0' + n : '' + n; }

  function updateInterviewTimer(){
    var elapsed = Math.floor((Date.now() - interviewStartTime) / 1000);
    var mm = Math.floor(elapsed / 60);
    var ss = elapsed % 60;
    els.interviewTimer.textContent = pad2(mm) + ':' + pad2(ss);
  }

  function startInterviewTimer(){
    interviewStartTime = Date.now();
    updateInterviewTimer();
    if(interviewTimerHandle) clearInterval(interviewTimerHandle);
    interviewTimerHandle = setInterval(updateInterviewTimer, 1000);
  }

  function stopInterviewTimer(){
    if(interviewTimerHandle){ clearInterval(interviewTimerHandle); interviewTimerHandle = null; }
  }

  // Keeps the header's Normal/Listen/Interview segmented toggle in sync
  // with which mode is actually active (a running Interview session, not
  // just the config modal being open; Listen Mode being the active view,
  // not just speech happening to be paused).
  function setModeUI(mode){
    els.normalModeBtn.classList.toggle('active', mode === 'normal');
    els.normalModeBtn.setAttribute('aria-selected', String(mode === 'normal'));
    els.listenModeBtn.classList.toggle('active', mode === 'listen');
    els.listenModeBtn.setAttribute('aria-selected', String(mode === 'listen'));
    els.interviewOpenBtn.classList.toggle('active', mode === 'interview');
    els.interviewOpenBtn.setAttribute('aria-selected', String(mode === 'interview'));
  }

  // ---------- Interview session history (localStorage, per-browser) ----------
  // A log that a session happened -- date, config used, how far it got,
  // how long it took. NOT scoring/correctness tracking (that's explicitly
  // out of scope, RULES.md §11) -- just a record, same spirit as the
  // pacing timer already shown during a session.
  var HISTORY_KEY = 'interviewHistory';
  var HISTORY_MAX = 50;

  function loadInterviewHistory(){
    try{
      var raw = localStorage.getItem(HISTORY_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch(e){
      return []; // localStorage unavailable (private mode, quota, etc.) -- history is a convenience, never block the app
    }
  }

  function saveInterviewHistory(list){
    try{ localStorage.setItem(HISTORY_KEY, JSON.stringify(list)); } catch(e){ /* ignore -- see above */ }
  }

  function recordInterviewHistoryEntry(entry){
    var list = loadInterviewHistory();
    list.unshift(entry); // newest first
    if(list.length > HISTORY_MAX) list = list.slice(0, HISTORY_MAX);
    saveInterviewHistory(list);
  }

  function clearInterviewHistory(){
    try{ localStorage.removeItem(HISTORY_KEY); } catch(e){ /* ignore */ }
  }

  // Set by launchInterview() at the start of a session, cleared by
  // finalizeInterviewSession() once it's been recorded -- so a session
  // gets recorded exactly once, however it ends (reaching the last
  // question, "End Interview", or a "Restart Same Session" that starts a
  // new one before finalizing the old).
  var currentSessionMeta = null;

  // Per-sheet average score for whatever got scored this session (only
  // meaningful if "Score my answers" was on) -- feeds Prioritize Weak
  // Sheets' weighting (below) so it can favor sheets you've scored
  // poorly on, not just sheets you've drilled less.
  function computeSessionSheetScores(){
    var bySheet = {};
    interviewQuestions.forEach(function(q, i){
      var a = interviewAnswers[i];
      if(!a || a.score === null) return;
      if(!bySheet[q.sheet]) bySheet[q.sheet] = { total: 0, count: 0 };
      bySheet[q.sheet].total += a.score;
      bySheet[q.sheet].count++;
    });
    var result = {};
    Object.keys(bySheet).forEach(function(s){ result[s] = bySheet[s].total / bySheet[s].count; });
    return result;
  }

  function finalizeInterviewSession(){
    if(!currentSessionMeta) return;
    var durationSec = Math.max(0, Math.floor((Date.now() - currentSessionMeta.startedAt) / 1000));
    var cfg = currentSessionMeta.config;
    var sheetScores = computeSessionSheetScores();
    var scoredCount = Object.keys(sheetScores).length;
    var avgScore = null;
    if(scoredCount){
      var total = 0, n = 0;
      interviewAnswers.forEach(function(a){ if(a.score !== null){ total += a.score; n++; } });
      avgScore = total / n;
    }
    recordInterviewHistoryEntry({
      date: new Date(currentSessionMeta.startedAt).toISOString(),
      sheets: cfg.sheets ? Array.from(cfg.sheets) : null,
      levels: cfg.levels ? Array.from(cfg.levels) : null,
      priorities: cfg.priorities ? Array.from(cfg.priorities) : null,
      balancedMix: !!cfg.balancedMix,
      prioritizeWeak: !!cfg.prioritizeWeak,
      randomize: !!cfg.randomize,
      totalQuestions: currentSessionMeta.totalQuestions,
      reachedCount: Math.min(interviewIndex + 1, currentSessionMeta.totalQuestions),
      durationSec: durationSec,
      avgScore: avgScore,
      sheetScores: sheetScores
    });
    currentSessionMeta = null;
  }

  function launchInterview(pool){
    // Finalize whatever session was running before this one (covers
    // "Restart Same Session", which calls launchInterview() again without
    // going through endInterview() first) so nothing is silently dropped.
    finalizeInterviewSession();

    interviewQuestions = pool;
    interviewIndex = 0;
    interviewAnswers = pool.map(function(){ return { answerText: '', score: null, feedback: null }; });
    currentSessionMeta = {
      startedAt: Date.now(),
      config: lastInterviewConfig,
      totalQuestions: pool.length
    };

    if(listenModeActive) exitListenMode();
    els.tableView.style.display = 'none';
    els.singleView.style.display = 'none';
    els.emptyState.style.display = 'none';
    document.querySelector('.toolbar').style.display = 'none';
    document.querySelector('.status-row').style.display = 'none';

    els.interviewView.style.display = 'block';
    els.interviewDone.style.display = 'none';
    els.interviewCard.style.display = 'flex';
    // Voice answer / scoring both need somewhere to write to -- force the
    // scratch box on even if the user didn't check it directly.
    var cfg = currentSessionMeta.config;
    els.iScratchRow.style.display = (cfg.showScratch || cfg.voiceAnswer || cfg.scoreAnswers) ? 'flex' : 'none';
    els.iMicBtn.style.display = (STT_SUPPORTED && cfg.voiceAnswer) ? 'flex' : 'none';
    setModeUI('interview');
    startInterviewTimer();
    renderInterviewQuestion();
  }

  // A question's phrasings (joined with "or" for browse mode) render here
  // as separate "Q." lines instead, per Interview Mode's practice format.
  function renderInterviewQuestion(){
    cancelInterviewSpeech();
    stopAnswerRecognition();
    var q = interviewQuestions[interviewIndex];
    var a = interviewAnswers[interviewIndex];
    els.iSheet.textContent = q.sheet;
    els.iCategory.textContent = q.category;
    els.iLevel.textContent = q.level;
    els.iPriority.textContent = q.priority || '—';
    els.iCompany.innerHTML = companyTagsHtml(q);
    // Restores this question's own answer text (if you've been here
    // before via Prev/Next) instead of always clearing it.
    if(els.iScratchRow.style.display !== 'none') els.iScratch.value = a.answerText;
    if(a.score !== null) renderScoreResult({ score: a.score, feedback: a.feedback });
    else els.iScoreResult.style.display = 'none';

    var parts = (q.questionParts && q.questionParts.length) ? q.questionParts : [q.question];
    els.iQuestionList.innerHTML = parts.map(function(part){
      return '<div class="q-part"><span>' + highlightFencedCode(part) + '</span></div>';
    }).join('');

    els.iAnswer.innerHTML = answerHtmlOrPlaceholder(q);
    els.iAnswerRow.style.display = 'none';
    els.iRevealBtn.style.display = 'inline-block';
    els.iRevealBtn.textContent = 'Reveal Answer';

    els.iPrevBtn.disabled = interviewIndex === 0;
    els.interviewProgress.textContent = 'Question ' + (interviewIndex + 1) + ' of ' + interviewQuestions.length;

    // Auto-read then auto-listen: if both are on, start the mic only
    // once the question's actually finished being spoken (not while --
    // it would otherwise transcribe the TTS audio as your answer). If
    // only voice-answer is on (no auto-read), start listening right away.
    var cfg = currentSessionMeta.config;
    if(cfg.autoRead){
      speakCurrentInterviewQuestion(function(){
        if(cfg.voiceAnswer) startAnswerRecognition();
      });
    } else if(cfg.voiceAnswer){
      startAnswerRecognition();
    }
  }

  // ---------- Interview: read question aloud (SpeechSynthesis) ----------
  // Browser built-in, no external service -- works fine on a static
  // GitHub Pages deploy. Speaks the plain-text question (questionPlain,
  // same field used for search). Manual via #iSpeakBtn/'R', or automatic
  // per question if "Auto-read each question aloud" is checked in the
  // config modal -- safe from autoplay blocking either way, since it
  // only ever fires from renderInterviewQuestion(), itself only reached
  // via a user click (Start/Next/Prev), never on page load.
  var SPEECH_SUPPORTED = typeof window !== 'undefined' && 'speechSynthesis' in window;

  function cancelInterviewSpeech(){
    if(SPEECH_SUPPORTED) window.speechSynthesis.cancel();
  }

  // ---------- Interview: voice picker for Read Aloud ----------
  // speechSynthesis doesn't pick a "best" voice on its own -- left alone,
  // it just uses whatever the browser's default happens to be, which can
  // be a flat robotic voice even when nicer ones (Chrome/Edge often ship
  // several "Online (Natural)"/"Neural" voices) are installed and
  // available. This lets the user pick, with a decent auto-picked default
  // so it sounds good before anyone touches the dropdown.
  var VOICE_PREF_KEY = 'interviewVoiceURI';

  function voiceQualityScore(voice){
    var name = voice.name || '';
    if(/natural|neural/i.test(name)) return 3;
    if(/online/i.test(name)) return 2;   // Microsoft's "X Online (Natural)" voices
    if(/google/i.test(name)) return 1;   // Chrome's Google voices, generally decent
    return 0;
  }

  // User-named favorites, in preferred order -- these always sort to the
  // TOP of the list (ahead of the general English-first/quality-score
  // heuristic below, and ahead of the usual "English voices before
  // non-English" rule, so Google हिन्दी still surfaces near the top
  // despite the app's content being English-only). Matched by exact name
  // (case-insensitive, trimmed) since these are how Chrome actually
  // labels its built-in Google voices.
  var FAVORITE_VOICE_PATTERNS = [
    /^google us english$/i,
    /^google uk english female$/i,
    /^google uk english male$/i,
    /^google (हिन्दी|hindi)$/i
  ];

  function favoriteVoiceRank(name){
    var trimmed = (name || '').trim();
    for(var i = 0; i < FAVORITE_VOICE_PATTERNS.length; i++){
      if(FAVORITE_VOICE_PATTERNS[i].test(trimmed)) return i;
    }
    return -1; // not a favorite
  }

  function generalVoiceSort(a, b){
    var aEn = /^en/i.test(a.lang) ? 0 : 1;
    var bEn = /^en/i.test(b.lang) ? 0 : 1;
    if(aEn !== bEn) return aEn - bEn;
    var scoreDiff = voiceQualityScore(b) - voiceQualityScore(a);
    if(scoreDiff !== 0) return scoreDiff;
    return a.name.localeCompare(b.name);
  }

  // Two selects show the same voice list and stay in sync (localStorage
  // is the shared source of truth): one in the config modal (pick before
  // starting, per the user's request), one in the active session topbar
  // (switch mid-session too).
  var VOICE_SELECT_ELS = null; // set lazily -- els isn't built yet at parse time

  function populateVoiceSelect(){
    if(!SPEECH_SUPPORTED) return;
    var voices = window.speechSynthesis.getVoices();
    if(!voices.length) return; // getVoices() can return empty until 'voiceschanged' fires
    if(!VOICE_SELECT_ELS) VOICE_SELECT_ELS = [els.iVoiceSelect, els.interviewVoiceSelect, els.lVoiceSelect];

    // Only the user's named favorites -- everything else is filtered out
    // of the dropdown entirely, not just sorted below them. If NONE of
    // the favorites are installed on this browser/OS, fall back to the
    // full list (English-first, then by voiceQualityScore()) rather than
    // leaving Read Aloud with an empty, unusable dropdown.
    var favorites = voices.filter(function(v){ return favoriteVoiceRank(v.name) !== -1; })
      .sort(function(a, b){ return favoriteVoiceRank(a.name) - favoriteVoiceRank(b.name); });
    var list = favorites.length ? favorites : voices.slice().sort(generalVoiceSort);

    var savedUri = null;
    try{ savedUri = localStorage.getItem(VOICE_PREF_KEY); } catch(e){ /* ignore */ }
    var savedStillAvailable = savedUri && list.some(function(v){ return v.voiceURI === savedUri; });
    var optionsHtml = list.map(function(v){
      return '<option value="' + escapeHtml(v.voiceURI) + '">' + escapeHtml(v.name) + '</option>';
    }).join('');
    var value = savedStillAvailable ? savedUri : list[0].voiceURI;

    VOICE_SELECT_ELS.forEach(function(sel){
      sel.innerHTML = optionsHtml;
      sel.value = value;
    });
  }

  function setInterviewVoicePreference(uri){
    try{ localStorage.setItem(VOICE_PREF_KEY, uri); } catch(e){ /* ignore */ }
    VOICE_SELECT_ELS.forEach(function(sel){ sel.value = uri; });
  }

  function getSelectedInterviewVoice(){
    if(!SPEECH_SUPPORTED || !els.iVoiceSelect.value) return null;
    var voices = window.speechSynthesis.getVoices();
    for(var i = 0; i < voices.length; i++){
      if(voices[i].voiceURI === els.iVoiceSelect.value) return voices[i];
    }
    return null;
  }

  // ---------- Listen Mode ----------
  // A third view of the SAME filtered pool Normal Mode shows -- no
  // separate config/session/pool like Interview Mode, just Sheet/Topic/
  // Level/Priority/Company/Answer filters + Search staying live while
  // one question at a time gets read aloud (Question, then Answer)
  // instead of read by eye. The toolbar/status-row stay visible and
  // functional the whole time (unlike Interview Mode, which hides them) —
  // changing a filter re-syncs the current listen position immediately.
  var listenModeActive = false;
  var listenIndex = 0;
  var listenPlaying = false;
  // Bumped on every stop/nav so a speechSynthesis 'onend' firing late (for
  // an utterance that's already been cancelled/superseded) can't chain
  // into reading the wrong question -- same guard pattern as Interview
  // Mode's speakCurrentInterviewQuestion().
  var listenUtteranceToken = 0;

  function goListenMode(){
    if(els.interviewModal.style.display !== 'none') closeInterviewModal();
    if(els.interviewView.style.display !== 'none') endInterview();
    if(listenModeActive) return;
    listenModeActive = true;
    listenIndex = 0;
    els.tableView.style.display = 'none';
    els.singleView.style.display = 'none';
    els.emptyState.style.display = 'none';
    setModeUI('listen');
    renderListenQuestion();
  }

  function exitListenMode(){
    if(!listenModeActive) return;
    pauseListen();
    listenModeActive = false;
    els.listenView.style.display = 'none';
    els.tableView.style.display = '';
    els.singleView.style.display = '';
  }

  function currentListenQuestion(){
    return filteredQuestions[listenIndex] || null;
  }

  // Pure display update -- never starts/continues speech on its own.
  function renderListenQuestion(){
    if(!listenModeActive) return;
    var total = filteredQuestions.length;
    if(total === 0){
      els.listenView.style.display = 'none';
      els.emptyState.style.display = 'block';
      return;
    }
    if(listenIndex >= total) listenIndex = total - 1;
    if(listenIndex < 0) listenIndex = 0;
    els.emptyState.style.display = 'none';
    els.listenView.style.display = 'flex';
    var q = filteredQuestions[listenIndex];
    els.lSheet.textContent = q.sheet;
    els.lCategory.textContent = q.category;
    els.lLevel.textContent = q.level;
    els.lPriority.textContent = q.priority || '—';
    els.lCompany.innerHTML = companyTagsHtml(q);
    els.lQuestion.innerHTML = questionPartsHtml(q);
    els.lAnswer.innerHTML = answerHtmlOrPlaceholder(q);
    els.listenStatus.textContent = 'Question ' + (listenIndex + 1) + ' of ' + total;
    els.listenPrevBtn.disabled = listenIndex === 0;
    els.listenNextBtn.disabled = listenIndex === total - 1;
  }

  // Called from applyFilters() on every filter/search change -- cheap
  // no-op when Listen Mode isn't the active view. Stops any in-progress
  // speech (the old pool's wording/position may no longer apply) rather
  // than letting it finish reading a question that might not even match
  // the new filters anymore.
  function refreshListenView(){
    if(!listenModeActive) return;
    pauseListen();
    listenIndex = 0; // a filter/search change means a different pool -- start from its top, same as currentIndex reset for mobile browse pagination
    renderListenQuestion();
  }

  function stopListenSpeech(){
    listenUtteranceToken++;
    if(SPEECH_SUPPORTED) window.speechSynthesis.cancel();
  }

  function setListenPlayButtonLabel(playing){
    els.listenPlayBtn.textContent = playing ? '⏸ Pause' : '▶ Play';
  }

  function pauseListen(){
    stopListenSpeech();
    listenPlaying = false;
    setListenPlayButtonLabel(false);
  }

  function speakListenText(text, onEnd){
    if(!SPEECH_SUPPORTED || !text || !text.trim()){ if(onEnd) onEnd(); return; }
    var utterance = new SpeechSynthesisUtterance(text);
    var voice = getSelectedInterviewVoice();
    if(voice) utterance.voice = voice;
    var token = listenUtteranceToken;
    var settled = false;
    var timeoutId = null;
    var settle = function(){
      if(settled || token !== listenUtteranceToken) return;
      settled = true;
      if(timeoutId) clearTimeout(timeoutId);
      if(onEnd) onEnd();
    };
    utterance.onend = settle;
    utterance.onerror = settle;
    // speechSynthesis' 'end' event is a known-unreliable part of the Web
    // Speech API -- it can silently never fire (seen reliably on longer
    // text in headless testing here; also reported in real Chrome on
    // backgrounded tabs), which would otherwise leave Listen Mode stuck
    // mid-utterance forever with no way out except Pause. A generous
    // per-character timeout (floor/ceiling guarded) force-advances if
    // 'end' never comes; clearTimeout above cancels it once 'end' (or
    // 'error') actually does fire first.
    var estimatedMs = Math.min(60000, Math.max(4000, text.length * 90));
    timeoutId = setTimeout(settle, estimatedMs);
    window.speechSynthesis.speak(utterance);
  }

  // Question, then Answer (or a spoken placeholder if none written yet),
  // then -- if still playing and auto-advance is checked -- moves to the
  // next question and repeats. This is the hands-free "just listen"
  // loop through whatever's currently filtered.
  function playListenSequence(){
    if(!listenModeActive || !listenPlaying) return;
    var q = currentListenQuestion();
    if(!q){ pauseListen(); return; }
    speakListenText(q.questionPlain, function(){
      if(!listenPlaying) return;
      var answerText = (q.answerPlain && q.answerPlain.trim()) ? q.answerPlain : 'No answer added in Excel yet.';
      speakListenText(answerText, function(){
        if(!listenPlaying) return;
        if(els.listenAutoAdvance.checked && listenIndex < filteredQuestions.length - 1){
          listenIndex++;
          renderListenQuestion();
          playListenSequence();
        } else {
          pauseListen();
        }
      });
    });
  }

  function playListen(){
    if(!listenModeActive || filteredQuestions.length === 0) return;
    listenPlaying = true;
    setListenPlayButtonLabel(true);
    playListenSequence();
  }

  function toggleListenPlay(){
    if(listenPlaying) pauseListen();
    else playListen();
  }

  // Prev/Next during playback stop the current utterance and immediately
  // continue playing from the new question, rather than requiring a
  // separate Play press -- browsing manually (not playing) just updates
  // the display without speaking.
  function listenGoTo(index){
    var wasPlaying = listenPlaying;
    stopListenSpeech();
    listenIndex = Math.max(0, Math.min(filteredQuestions.length - 1, index));
    renderListenQuestion();
    if(wasPlaying) playListenSequence();
  }

  function listenPrev(){ listenGoTo(listenIndex - 1); }
  function listenNext(){ listenGoTo(listenIndex + 1); }

  // onEnd (optional): called when speech actually finishes -- used to
  // auto-start the mic only AFTER the question's been read, not while,
  // so it doesn't pick up the TTS audio itself as your answer.
  function speakCurrentInterviewQuestion(onEnd){
    if(!SPEECH_SUPPORTED){ if(onEnd) onEnd(); return; }
    var q = interviewQuestions[interviewIndex];
    if(!q){ if(onEnd) onEnd(); return; }
    cancelInterviewSpeech();
    var utterance = new SpeechSynthesisUtterance(q.questionPlain);
    var voice = getSelectedInterviewVoice();
    if(voice) utterance.voice = voice;
    if(onEnd){
      // Guards against a stale callback firing after you've already
      // navigated to a different question (cancel()/rapid Next/Prev can
      // still fire 'onend' for the utterance being replaced).
      var indexAtSpeak = interviewIndex;
      utterance.onend = function(){
        if(interviewIndex === indexAtSpeak) onEnd();
      };
    }
    window.speechSynthesis.speak(utterance);
  }

  // ---------- Interview: Focus Mode ----------
  // Dims/shrinks secondary chrome for a more immersive session, but
  // deliberately does NOT hide the header/mode-toggle -- that stays
  // reachable at all times per RULES.md's "no dead end" rule; Focus Mode
  // only lowers its opacity (hover restores it), it's still clickable.
  function toggleFocusMode(){
    var active = document.body.classList.toggle('focus-mode');
    els.iFocusBtn.classList.toggle('active', active);
    els.iFocusBtn.setAttribute('aria-pressed', String(active));
  }

  function disableFocusMode(){
    document.body.classList.remove('focus-mode');
    els.iFocusBtn.classList.remove('active');
    els.iFocusBtn.setAttribute('aria-pressed', 'false');
  }

  // ---------- Interview: rule-based answer scoring (no AI, no backend) ----------
  // Proxy for "did you say enough, relevant, well-formed stuff" -- NOT true
  // correctness/reasoning grading, which would need an LLM call (and a
  // backend to hold the API key, which this static site doesn't have).
  // Compares the scratch-box text against the real reference answer.
  var SCORE_STOPWORDS = ['this','that','with','from','have','been','were','they',
    'their','which','would','could','should','about','there','these','those',
    'into','your','also','when','what','where','while','than','then'];
  var SCORE_FILLER_WORDS = ['um','uh','like','you know','basically','actually','sort of','kind of'];

  function scoreMeaningfulWords(text){
    var raw = (text || '').toLowerCase().replace(/<[^>]+>/g, ' ').match(/[a-z]{4,}/g) || [];
    return Array.from(new Set(raw)).filter(function(w){ return SCORE_STOPWORDS.indexOf(w) === -1; });
  }

  function scoreInterviewAnswer(answerText, referenceText){
    var words = (answerText || '').trim().split(/\s+/).filter(Boolean);
    var wordCount = words.length;

    var lengthScore = wordCount === 0 ? 0 : wordCount < 15 ? 1 : wordCount < 40 ? 2 : wordCount < 80 ? 3 : 4;

    var refWords = scoreMeaningfulWords(referenceText);
    var ansWords = new Set(scoreMeaningfulWords(answerText));
    var overlap = refWords.filter(function(w){ return ansWords.has(w); }).length;
    var overlapRatio = refWords.length ? overlap / refWords.length : 0;
    var keywordScore = Math.round(overlapRatio * 4);

    var sentenceCount = (answerText || '').split(/[.!?]+/).filter(function(s){ return s.trim().length > 0; }).length;
    var structureBonus = sentenceCount >= 2 ? 1 : 0;

    var lowerAns = (answerText || '').toLowerCase();
    var fillerCount = SCORE_FILLER_WORDS.reduce(function(sum, f){
      var re = new RegExp('\\b' + f.replace(/ /g, '\\s+') + '\\b', 'g');
      return sum + ((lowerAns.match(re) || []).length);
    }, 0);
    var fillerPenalty = Math.min(2, Math.floor(fillerCount / 2));

    var score = Math.max(0, Math.min(10, lengthScore + keywordScore + structureBonus - fillerPenalty));

    var feedback;
    if(wordCount === 0) feedback = 'No answer given.';
    else if(score >= 8) feedback = 'Strong answer -- good length and relevant detail.';
    else if(score >= 5) feedback = 'Reasonable answer -- could use more relevant detail.';
    else feedback = 'Short on relevant detail compared to the reference answer.';

    return { score: score, feedback: feedback };
  }

  function renderScoreResult(result){
    els.iScoreResult.innerHTML = '<span class="score-num">' + result.score + '/10</span> — ' + escapeHtml(result.feedback);
    els.iScoreResult.style.display = 'block';
  }

  // ---------- Interview: answer by voice (SpeechRecognition) ----------
  // Separate Web API from SpeechSynthesis (Read Aloud) -- this is speech
  // INPUT, not output. Reliable in Chrome/Edge only; Firefox/Safari don't
  // support it, hence the feature-detect + hide-if-unsupported, same
  // pattern as Read Aloud. Requires a secure context (https or localhost)
  // -- won't work opened via file://, same limitation §1 already accepts
  // for anything path-sensitive; GitHub Pages itself is https, so it's
  // fine there.
  var SpeechRecognitionCtor = window.SpeechRecognition || window.webkitSpeechRecognition;
  var STT_SUPPORTED = !!SpeechRecognitionCtor;
  var answerRecognition = null;
  var answerRecognizing = false;

  // Speech-to-text recognition language is a SEPARATE setting from the
  // Read Aloud voice above -- switching the question-reading voice to
  // e.g. Google हिन्दी does NOT change what language your spoken answer
  // gets recognized as (a real mix-up the user hit and asked about).
  // This is the actual lever for answer-recognition accuracy.
  var STT_LANG_KEY = 'interviewSttLang';

  function getSttLang(){
    try{
      var saved = localStorage.getItem(STT_LANG_KEY);
      if(saved) return saved;
    } catch(e){ /* ignore */ }
    return 'en-US';
  }
  // True while the user actually wants listening to continue -- separate
  // from answerRecognizing, which just reflects whether a recognizer
  // instance is live right now. Chrome's `continuous` mode silently ends
  // itself after a pause/timeout even though nothing went wrong; without
  // this flag, that silent stop just looks like "still listening" in the
  // UI while actually dropping the rest of what you say. onend checks
  // this and restarts automatically unless the user (or navigation)
  // explicitly asked to stop.
  var answerRecognitionWanted = false;

  // Nulls the handlers and aborts synchronously, rather than relying on
  // the async onend to clean up -- otherwise navigating to the next
  // question before onend fires lets the OLD recognizer's onresult keep
  // firing into the NEW question's scratch box (a real race: Q1's mic
  // still "warm" writes transcript into Q2's textarea).
  function setMicUI(active){
    els.iMicBtn.classList.toggle('active', active);
    els.iMicStatus.style.display = active ? 'block' : 'none';
  }

  function stopAnswerRecognition(){
    answerRecognitionWanted = false;
    if(answerRestartTimer){ clearTimeout(answerRestartTimer); answerRestartTimer = null; }
    if(!answerRecognition) return;
    answerRecognition.onresult = null;
    answerRecognition.onend = null;
    answerRecognition.onerror = null;
    try{ answerRecognition.abort(); } catch(e){ /* already stopped */ }
    answerRecognition = null;
    answerRecognizing = false;
    setMicUI(false);
  }

  function startAnswerRecognition(){
    if(!STT_SUPPORTED) return;
    answerRecognitionWanted = true;
    var baseText = els.iScratch.value ? els.iScratch.value.replace(/\s+$/, '') + ' ' : '';
    answerRecognition = new SpeechRecognitionCtor();
    answerRecognition.lang = getSttLang();
    answerRecognition.continuous = true;
    answerRecognition.interimResults = true;
    answerRecognition.onresult = function(e){
      var interim = '', final = '';
      for(var i = e.resultIndex; i < e.results.length; i++){
        var transcript = e.results[i][0].transcript;
        if(e.results[i].isFinal) final += transcript;
        else interim += transcript;
      }
      if(final) baseText += final + ' ';
      els.iScratch.value = baseText + interim;
      syncCurrentAnswerText();
    };
    answerRecognition.onend = function(){
      answerRecognizing = false;
      syncCurrentAnswerText();
      if(answerRecognitionWanted) restartAnswerRecognitionSoon();
      else setMicUI(false);
    };
    answerRecognition.onerror = function(e){
      answerRecognizing = false;
      // 'not-allowed'/'audio-capture' mean the mic itself is the problem
      // -- give up instead of restart-looping forever. Other errors
      // ('no-speech', 'network', ...) are the recoverable kind onend's
      // auto-restart is meant to ride through -- onerror is always
      // followed by onend, so no need to also restart from here.
      if(e.error === 'not-allowed' || e.error === 'audio-capture'){
        answerRecognitionWanted = false;
        setMicUI(false);
      }
    };
    try{
      answerRecognition.start();
      answerRecognizing = true;
      setMicUI(true);
    } catch(e){
      // Starting immediately after a stop can throw on some browsers --
      // the previous session hasn't finished releasing the mic yet. This
      // used to fail silently here, leaving the mic looking "off" while
      // you kept talking and nothing was captured. Retry instead of
      // giving up.
      if(answerRecognitionWanted) restartAnswerRecognitionSoon();
    }
  }

  // A short delay before restarting avoids the immediate-restart failure
  // above in the first place (rather than only recovering from it) --
  // this is what actually rides through a mid-answer pause instead of
  // silently dropping everything you say after it.
  var answerRestartTimer = null;
  function restartAnswerRecognitionSoon(){
    setMicUI(false); // brief, honest "not listening right now" instead of pretending it's seamless
    if(answerRestartTimer) clearTimeout(answerRestartTimer);
    answerRestartTimer = setTimeout(function(){
      answerRestartTimer = null;
      if(answerRecognitionWanted) startAnswerRecognition();
    }, 300);
  }

  function toggleAnswerRecognition(){
    if(answerRecognitionWanted) stopAnswerRecognition();
    else startAnswerRecognition();
  }

  // Persists the scratch box's current text against the current question
  // index -- interviewAnswers is parallel to interviewQuestions, reset
  // fresh each launchInterview() so Prev/Next can restore per-question
  // text instead of always clearing it.
  function syncCurrentAnswerText(){
    if(!interviewAnswers[interviewIndex]) return;
    interviewAnswers[interviewIndex].answerText = els.iScratch.value;
  }

  function revealInterviewAnswer(){
    stopAnswerRecognition(); // don't keep listening once you've moved on to checking the answer
    els.iAnswerRow.style.display = 'flex';
    els.iRevealBtn.style.display = 'none';
    if(currentSessionMeta && currentSessionMeta.config.scoreAnswers){
      var q = interviewQuestions[interviewIndex];
      var result = scoreInterviewAnswer(els.iScratch.value, q.answerPlain);
      interviewAnswers[interviewIndex].score = result.score;
      interviewAnswers[interviewIndex].feedback = result.feedback;
      renderScoreResult(result);
    }
  }

  function interviewPrev(){
    if(interviewIndex > 0){
      interviewIndex--;
      renderInterviewQuestion();
    }
  }

  function interviewNext(){
    if(interviewIndex < interviewQuestions.length - 1){
      interviewIndex++;
      renderInterviewQuestion();
    } else {
      stopInterviewTimer();
      cancelInterviewSpeech();
      stopAnswerRecognition();
      finalizeInterviewSession();
      els.interviewCard.style.display = 'none';
      els.interviewDone.style.display = 'block';
      els.interviewProgress.textContent = 'Finished — ' + interviewQuestions.length + ' of ' + interviewQuestions.length;
      renderInterviewCompletionScore();
    }
  }

  // Builds the score summary + per-sheet breakdown shown on the
  // completion screen, and shows/hides the Export button -- only if
  // scoring was actually on and at least one question got scored (e.g.
  // the user might have skipped writing any answers).
  function renderInterviewCompletionScore(){
    var scored = interviewAnswers.filter(function(a){ return a.score !== null; });
    if(!scored.length){
      els.interviewScoreSummary.style.display = 'none';
      els.interviewExportBtn.style.display = 'none';
      return;
    }

    var overall = scored.reduce(function(sum, a){ return sum + a.score; }, 0) / scored.length;
    els.interviewOverallScore.textContent = 'Average score: ' + overall.toFixed(1) + '/10';

    var bySheet = {};
    interviewQuestions.forEach(function(q, i){
      var a = interviewAnswers[i];
      if(a.score === null) return;
      if(!bySheet[q.sheet]) bySheet[q.sheet] = { total: 0, count: 0 };
      bySheet[q.sheet].total += a.score;
      bySheet[q.sheet].count++;
    });
    els.interviewScoreBreakdown.innerHTML = Object.keys(bySheet).sort().map(function(s){
      var avg = (bySheet[s].total / bySheet[s].count).toFixed(1);
      return '<div class="score-breakdown-row"><span>' + escapeHtml(s) + '</span><span>' +
        avg + '/10 (' + bySheet[s].count + ')</span></div>';
    }).join('');

    els.interviewScoreSummary.style.display = 'block';
    els.interviewExportBtn.style.display = 'inline-block';
  }

  // Plain-text export: question, your answer, the reference answer, and
  // score per question -- client-side Blob + a throwaway <a download>,
  // no server involved (works the same on GitHub Pages).
  function exportInterviewSessionTxt(){
    var lines = ['Interview Prep Hub -- session export', new Date().toLocaleString(), ''];
    interviewQuestions.forEach(function(q, i){
      var a = interviewAnswers[i];
      lines.push('Q' + (i + 1) + '. [' + q.sheet + '] ' + q.questionPlain);
      lines.push('Your answer: ' + (a.answerText || '(none)'));
      if(a.score !== null) lines.push('Score: ' + a.score + '/10 -- ' + a.feedback);
      lines.push('Reference answer: ' + (q.answerPlain || '(none in Excel yet)'));
      lines.push('');
    });

    var blob = new Blob([lines.join('\n')], { type: 'text/plain' });
    var url = URL.createObjectURL(blob);
    var a2 = document.createElement('a');
    a2.href = url;
    a2.download = 'interview-session-' + new Date().toISOString().slice(0, 10) + '.txt';
    document.body.appendChild(a2);
    a2.click();
    document.body.removeChild(a2);
    URL.revokeObjectURL(url);
  }

  function endInterview(){
    stopInterviewTimer();
    cancelInterviewSpeech();
    stopAnswerRecognition();
    disableFocusMode();
    finalizeInterviewSession(); // no-op if already finalized (e.g. "Exit to Browse" after completion)
    setModeUI('normal');
    els.interviewView.style.display = 'none';
    document.querySelector('.toolbar').style.display = 'flex';
    document.querySelector('.status-row').style.display = 'flex';
    // Clear the inline display:none that launchInterview() set — without
    // this, browse mode's table/card view stays hidden forever, since an
    // inline style overrides the CSS media-query rules that normally
    // control #tableView/#singleView visibility.
    els.tableView.style.display = '';
    els.singleView.style.display = '';
    applyFilters();
  }

  // "Normal Mode" is the explicit, always-visible way back to browse mode
  // — if an Interview session is running, end it; if Listen Mode is
  // active, exit it; otherwise it's a no-op (already in Normal Mode).
  // Also dismisses the config modal if it's open.
  function goNormalMode(){
    if(els.interviewModal.style.display !== 'none'){
      closeInterviewModal();
    }
    if(els.interviewView.style.display !== 'none'){
      endInterview();
      return;
    }
    if(listenModeActive){
      exitListenMode();
      setModeUI('normal');
    }
  }

  function restartInterviewSession(){
    if(!lastInterviewConfig) return;
    var pool = buildInterviewPool(lastInterviewConfig);
    // Same config already produced a non-empty pool once (that's the only
    // way lastInterviewConfig gets set -- see startInterviewFromModal()),
    // and DATA doesn't change mid-session, so this should never be empty
    // in practice. Guarded anyway so a future change to that invariant
    // can't turn into a renderInterviewQuestion() crash on undefined q.
    if(pool.length === 0) return;
    launchInterview(pool);
  }

  // "Restart Same Session" (above) re-runs buildInterviewPool() on the
  // same config, which reshuffles/re-picks -- a fresh draw, not the same
  // questions. "Repeat Same Questions" instead relaunches with the exact
  // array just finished, same questions in the same order, for drilling
  // one specific set to mastery rather than always getting a new pull.
  function repeatInterviewSession(){
    if(!interviewQuestions || interviewQuestions.length === 0) return;
    launchInterview(interviewQuestions.slice());
  }

  // ---------- Interview session history modal ----------

  function formatHistoryDate(iso){
    try{
      var d = new Date(iso);
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) +
        ' ' + d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
    } catch(e){
      return iso;
    }
  }

  function formatHistoryDuration(sec){
    var mm = Math.floor(sec / 60), ss = sec % 60;
    return pad2(mm) + ':' + pad2(ss);
  }

  function renderHistoryList(){
    var list = loadInterviewHistory();
    if(list.length === 0){
      els.historyList.innerHTML = '';
      els.historyEmpty.style.display = 'block';
      return;
    }
    els.historyEmpty.style.display = 'none';
    els.historyList.innerHTML = list.map(function(item, i){
      var sheetsLabel = item.sheets ? item.sheets.join(', ') : 'All sheets';
      var levelLabel = item.levels ? item.levels.join(', ') : 'Any level';
      var priorityLabel = item.priorities ? item.priorities.join(', ') : 'Any priority';
      var mixLabel = item.balancedMix ? ' · Balanced Mix' : '';
      var scoreLabel = (item.avgScore !== null && item.avgScore !== undefined) ?
        ' · ' + item.avgScore.toFixed(1) + '/10' : '';
      return '<div class="history-item">' +
        '<div class="history-top">' +
          '<span class="history-date">' + escapeHtml(formatHistoryDate(item.date)) + '</span>' +
          '<span class="history-duration">' + formatHistoryDuration(item.durationSec) + '</span>' +
        '</div>' +
        '<div class="history-meta">' + item.reachedCount + ' of ' + item.totalQuestions + ' questions' + mixLabel + scoreLabel + '</div>' +
        '<div class="history-meta">Sheets: ' + escapeHtml(sheetsLabel) + '</div>' +
        '<div class="history-meta">Level: ' + escapeHtml(levelLabel) + ' · Priority: ' + escapeHtml(priorityLabel) + '</div>' +
        '<div class="history-actions">' +
          '<button class="btn ghost small history-reuse-btn" type="button" data-index="' + i + '">Use this config again</button>' +
          '<button class="btn ghost small history-delete-btn" type="button" data-index="' + i + '">Delete</button>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  function deleteHistoryEntry(index){
    var list = loadInterviewHistory();
    list.splice(index, 1);
    saveInterviewHistory(list);
    renderHistoryList();
  }

  // Re-fills the Interview Mode modal from a past session's config and
  // opens it for review/start -- doesn't auto-start, since Balanced
  // Mix/Prioritize Weak reshuffle each time anyway. History doesn't store
  // the originally-typed count, so totalQuestions (the actual delivered
  // pool size) is used as a reasonable stand-in.
  function reuseHistoryConfig(entry){
    closeHistoryModal();
    openInterviewModal();
    applyInterviewPreset({
      sheets: entry.sheets, levels: entry.levels, priorities: entry.priorities,
      count: entry.totalQuestions, randomize: entry.randomize,
      balancedMix: entry.balancedMix, prioritizeWeak: entry.prioritizeWeak,
      showScratch: false, autoRead: false, voiceAnswer: false, scoreAnswers: false
    });
    updateInterviewLiveFeedback();
  }

  function openHistoryModal(){
    renderHistoryList();
    els.historyModal.style.display = 'flex';
  }

  function closeHistoryModal(){
    els.historyModal.style.display = 'none';
  }

  // ---------- Interview session keyboard shortcuts ----------
  // Space/Enter: reveal the answer if hidden, otherwise advance to the
  // next question (mirrors common flashcard-app pacing). Arrow keys:
  // Previous/Next. Scoped to when a session is actually active and the
  // question card (not the completion screen) is showing, and ignored
  // while any text input has focus so it never steals keystrokes from a
  // field elsewhere on the page.
  document.addEventListener('keydown', function(e){
    if(els.interviewView.style.display !== 'block') return;
    if(els.interviewCard.style.display === 'none') return;
    var tag = (e.target && e.target.tagName) || '';
    if(tag === 'INPUT' || tag === 'TEXTAREA') return;

    if(e.key === ' ' || e.key === 'Enter'){
      e.preventDefault();
      if(els.iRevealBtn.style.display !== 'none') revealInterviewAnswer();
      else interviewNext();
    } else if(e.key === 'ArrowRight'){
      interviewNext();
    } else if(e.key === 'ArrowLeft'){
      interviewPrev();
    } else if(e.key === 'r' || e.key === 'R'){
      speakCurrentInterviewQuestion();
    }
  });

  function init(){
    if(allQuestions.length === 0){
      els.loadingNote.style.display = 'block';
      els.loadingNote.className = 'card note error';
      els.loadingNote.textContent = 'No questions embedded — add entries to the DATA array in the script.';
      return;
    }
    els.loadingNote.style.display = 'none';

    var sheetCount = uniqueValues('sheet').length;
    els.headerSubtitle.textContent = allQuestions.length + ' question' + (allQuestions.length === 1 ? '' : 's') +
      ' across ' + sheetCount + ' sheet' + (sheetCount === 1 ? '' : 's') + ', embedded from the Excel workbook';

    buildFilterButtons();
    applyFilters();
  }

  applyThemeIcon(currentThemeMode());
  els.themeToggle.addEventListener('click', cycleTheme);
  // Live-follow the OS preference for as long as the tab is open, but
  // only while in Auto -- an explicit Light/Dark pin should never move
  // on its own just because the OS setting changed.
  if(window.matchMedia){
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', function(){
      if(currentThemeMode() === 'auto') applyResolvedTheme();
    });
  }

  els.search.addEventListener('input', applyFilters);
  els.clearFiltersBtn.addEventListener('click', clearAllFilters);
  els.prevBtn.addEventListener('click', goPrev);
  els.nextBtn.addEventListener('click', goNext);

  els.normalModeBtn.addEventListener('click', goNormalMode);
  els.listenModeBtn.addEventListener('click', goListenMode);
  els.listenPlayBtn.addEventListener('click', toggleListenPlay);
  els.listenPrevBtn.addEventListener('click', listenPrev);
  els.listenNextBtn.addEventListener('click', listenNext);
  els.interviewOpenBtn.addEventListener('click', openInterviewModal);
  els.interviewCloseBtn.addEventListener('click', closeInterviewModal);
  els.interviewCancelBtn.addEventListener('click', closeInterviewModal);
  els.interviewModal.addEventListener('click', function(e){
    if(e.target === els.interviewModal) closeInterviewModal();
  });
  els.interviewStartBtn.addEventListener('click', startInterviewFromModal);
  els.iRevealBtn.addEventListener('click', revealInterviewAnswer);
  els.iPrevBtn.addEventListener('click', interviewPrev);
  els.iNextBtn.addEventListener('click', interviewNext);
  els.interviewEndBtn.addEventListener('click', endInterview);
  els.interviewExitBtn.addEventListener('click', endInterview);
  els.interviewRestartBtn.addEventListener('click', restartInterviewSession);
  els.interviewRepeatBtn.addEventListener('click', repeatInterviewSession);
  els.iSpeakBtn.addEventListener('click', function(){ speakCurrentInterviewQuestion(); });
  els.iFocusBtn.addEventListener('click', toggleFocusMode);
  if(SPEECH_SUPPORTED){
    populateVoiceSelect();
    // Chrome (and some others) load the voice list asynchronously --
    // getVoices() can return [] on the very first call, so this re-runs
    // once the real list is ready. Safe to fire more than once.
    window.speechSynthesis.onvoiceschanged = populateVoiceSelect;
    els.iVoiceSelect.addEventListener('change', function(){ setInterviewVoicePreference(els.iVoiceSelect.value); });
    els.interviewVoiceSelect.addEventListener('change', function(){ setInterviewVoicePreference(els.interviewVoiceSelect.value); });
    els.lVoiceSelect.addEventListener('change', function(){ setInterviewVoicePreference(els.lVoiceSelect.value); });
  } else {
    els.iSpeakBtn.style.display = 'none';
    els.iVoiceSelect.style.display = 'none';
    els.interviewAutoRead.closest('label').style.display = 'none';
    // Listen Mode has nothing to actually listen to without TTS support --
    // hide it entirely rather than offering a mode that can only show text.
    els.listenModeBtn.style.display = 'none';
  }

  els.iMicBtn.addEventListener('click', toggleAnswerRecognition);
  els.iScratch.addEventListener('input', syncCurrentAnswerText);
  els.iScratchClearBtn.addEventListener('click', function(){
    stopAnswerRecognition();
    els.iScratch.value = '';
    syncCurrentAnswerText();
    els.iScratch.focus();
  });
  els.interviewExportBtn.addEventListener('click', exportInterviewSessionTxt);
  if(!STT_SUPPORTED) els.interviewVoiceAnswer.closest('label').style.display = 'none';
  if(!SPEECH_SUPPORTED || !STT_SUPPORTED) els.voiceUnsupportedNote.style.display = 'block';

  // Config-modal Voice section: only shown if at least one of Read
  // Aloud/answer-recognition is actually usable, and each sub-control
  // only shown if ITS OWN feature is supported (a browser could support
  // one but not the other).
  if(SPEECH_SUPPORTED || STT_SUPPORTED) els.interviewVoiceSection.style.display = 'block';
  if(SPEECH_SUPPORTED) els.interviewVoiceSubBlock.style.display = 'block';
  if(STT_SUPPORTED){
    els.interviewSttLangSubBlock.style.display = 'block';
    els.interviewSttLangSelect.addEventListener('change', function(){
      try{ localStorage.setItem(STT_LANG_KEY, els.interviewSttLangSelect.value); } catch(e){ /* ignore */ }
    });
  }

  els.interviewPresetSelect.addEventListener('change', loadSelectedInterviewPreset);
  els.interviewPresetSaveBtn.addEventListener('click', saveCurrentInterviewPreset);
  els.interviewPresetDeleteBtn.addEventListener('click', deleteSelectedInterviewPreset);
  els.interviewPresetStartBtn.addEventListener('click', function(){
    if(!els.interviewPresetSelect.value) return; // no preset picked -- nothing to start
    loadSelectedInterviewPreset();
    startInterviewFromModal();
  });

  // Event-delegated: any chip click inside these containers bubbles up.
  els.interviewSheetList.addEventListener('click', updateInterviewLiveFeedback);
  els.interviewLevelList.addEventListener('click', updateInterviewLiveFeedback);
  els.interviewPriorityList.addEventListener('click', updateInterviewLiveFeedback);
  els.interviewCountInput.addEventListener('input', updateInterviewLiveFeedback);

  els.historyOpenBtn.addEventListener('click', openHistoryModal);
  els.historyCloseBtn.addEventListener('click', closeHistoryModal);
  els.historyCloseFooterBtn.addEventListener('click', closeHistoryModal);
  els.historyClearBtn.addEventListener('click', function(){
    clearInterviewHistory();
    renderHistoryList();
  });
  els.historyModal.addEventListener('click', function(e){
    if(e.target === els.historyModal) closeHistoryModal();
  });
  els.historyList.addEventListener('click', function(e){
    var reuseBtn = e.target.closest('.history-reuse-btn');
    if(reuseBtn){
      var entry = loadInterviewHistory()[parseInt(reuseBtn.dataset.index, 10)];
      if(entry) reuseHistoryConfig(entry);
      return;
    }
    var deleteBtn = e.target.closest('.history-delete-btn');
    if(deleteBtn) deleteHistoryEntry(parseInt(deleteBtn.dataset.index, 10));
  });

  init();

})();
</script>
</body>
</html>
